{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 0,
    "modules-left": [
        "clock",
        "custom/media",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "network",
        "bluetooth",
        "battery",
        "custom/system",
        "backlight",
        "pulseaudio",
        "custom/power"
    ],
    "custom/media": {
        "format": "{}",
        "return-type": "json",
        "exec": "/home/bren/.local/bin/waybar-media",
        "interval": 2,
        "on-click": "/home/bren/.local/bin/media-player",
        "on-click-right": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "hyprland/window": {
        "format": "{}"
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "clock": {
        "format": "  {:%d-%m-%Y    %H:%M}",
        "on-click": "/home/bren/.local/bin/calendar-app",
        "interval": 1,
        "rotate": 0,
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 1,
            "on-scroll": 1,
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        }
    },
    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-linked": "󰈀  {ifname} (No IP)",
        "format-disconnected": "󰖪 ",
        "format-disabled": "󰖪 ",
        "tooltip-format-disabled": "Wi-Fi kapalı",
        "tooltip-format": "{essid} (%{signalStrength})\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Bağlantı yok",
        "on-click": "/home/bren/.local/bin/wifi-manager",
        "interval": 2,
        "on-click-right": "/home/bren/.local/bin/toggle-wifi",
        "tooltip-format-ethernet": "Ethernet: {ipaddr}"
    },
    "bluetooth": {
        "format": "",
        "format-connected": " {device_alias}",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "tooltip-format": "Bluetooth açık (Bağlı cihaz yok)",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "• {device_alias}",
        "on-click": "/home/bren/.local/bin/bluetooth-manager",
        "on-click-right": "rfkill toggle bluetooth",
        "tooltip-format-disabled": "Bluetooth kapalı",
        "tooltip-format-off": "Bluetooth kapalı"
    },
    "custom/system": {
        "format": "{}",
        "return-type": "json",
        "exec": "/home/bren/.local/bin/waybar-system",
        "interval": 2,
        "on-click": "/home/bren/.local/bin/task-manager",
        "tooltip": true
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "tooltip": true,
        "tooltip-format": "Parlaklık: %{percent}\n(Sağ Tık: Açık/Koyu Tema Değiştir)",
        "on-click-right": "/home/bren/.local/bin/toggle-theme",
        "on-scroll-up": "/home/bren/.local/bin/change-brightness up",
        "on-scroll-down": "/home/bren/.local/bin/change-brightness down",
        "min-length": 6
    },
    "battery": {
        "on-click": "/home/bren/.local/bin/power-menu",
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": [
            "󰂃",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "{timeTo} kaldı (%{capacity})",
        "tooltip-format-charging": "{timeTo} doluma (%{capacity})",
        "tooltip-format-plugged": "Prizde (%{capacity})",
        "tooltip-format-full": "Tam dolu (%100)"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "tooltip": true,
        "format-muted": "  Muted",
        "on-click": "/home/bren/.local/bin/audio-mixer",
        "on-click-right": "pamixer -t",
        "on-scroll-up": "pamixer -i 1",
        "on-scroll-down": "pamixer -d 1",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                "",
                ""
            ]
        },
        "tooltip-format": "{desc}: %{volume}",
        "tooltip-format-muted": "{desc}: Sessiz"
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "tooltip-format": "Güç ve Oturum Menüsü",
        "on-click": "/home/bren/.local/bin/power-session"
    }
}