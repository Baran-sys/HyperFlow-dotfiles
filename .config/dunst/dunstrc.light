[global]
    monitor = 0
    follow = mouse
    width = (320, 380)
    height = (60, 250)
    origin = top-right
    offset = 18x54
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 180
    progress_bar_max_width = 320
    progress_bar_corner_radius = 3

    ### Display ###
    indicate_hidden = yes
    separator_height = 3
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 1
    gap_size = 8
    separator_color = frame
    sort = yes
    idle_threshold = 120

    ### Text ###
    font = JetBrainsMono Nerd Font 10
    line_height = 4
    markup = full
    format = "<span font_desc='JetBrainsMono Nerd Font Bold 10.5'>%s</span>\n<span font_desc='JetBrainsMono Nerd Font 9.5'>%b</span>"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 8
    icon_theme = "Tela-circle-dracula"
    enable_recursive_icon_lookup = true

    ### History & Interactions ###
    sticky_history = yes
    history_length = 20
    dmenu = /home/bren/.local/bin/tofi --prompt-text "dunst: "
    browser = /usr/bin/firefox --new-tab
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 14
    timeout = 5

    ### Mouse Actions ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#eff1f5f2"
    foreground = "#4c4f69"
    frame_color = "#ccd0da"
    highlight = "#1e66f5"
    timeout = 4

[urgency_normal]
    background = "#eff1f5f2"
    foreground = "#4c4f69"
    frame_color = "#bcc0cc"
    highlight = "#1e66f5"
    timeout = 5

[urgency_critical]
    background = "#eff1f5f2"
    foreground = "#4c4f69"
    frame_color = "#d20f39"
    highlight = "#d20f39"
    timeout = 0
