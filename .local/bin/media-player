class MediaPlayerWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(title="Media Player", application=app)
        self.set_default_size(291, 375)

        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", self.on_focus_out)
        self.ready_to_close = False
        GLib.timeout_add(250, lambda: setattr(self, "ready_to_close", True) or False)
        try:
            from waybar_focus import SmartFocus
            SmartFocus.setup(self, align="left", offset=202)
        except Exception:
            pass
        self.is_seeking = False
        self.track_length = 0
        self.current_art_url = None
        self.current_player_name = None
        self.current_volume_pct = 100
        self._vol_scroll_acc = 0.0
        self._last_vol_scroll_time = 0.0

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_box)

        # HeaderBar
        self.header = Gtk.HeaderBar()
        self.header.set_show_close_button(True)
        self.header.set_title("Media Player")
        self.header.set_subtitle("MPRIS2 Controller")
        self.set_titlebar(self.header)

        # Content Box
        self.content_stack = Gtk.Stack()
        self.content_stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        main_box.pack_start(self.content_stack, True, True, 0)

        # Page 1: Empty state (Material 3 Style)
        box_empty = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box_empty.set_valign(Gtk.Align.CENTER)
        box_empty.set_halign(Gtk.Align.CENTER)
        box_empty.set_margin_start(16)
        box_empty.set_margin_end(16)

        icon_box = Gtk.Box()
        icon_box.set_halign(Gtk.Align.CENTER)
        icon_box.get_style_context().add_class("empty-icon-circle")
        img_no_media = Gtk.Image.new_from_icon_name("audio-x-generic-symbolic", Gtk.IconSize.DIALOG)
        img_no_media.set_pixel_size(40)
        icon_box.pack_start(img_no_media, True, True, 0)
        box_empty.pack_start(icon_box, False, False, 0)

        lbl_empty_title = Gtk.Label()
        lbl_empty_title.set_markup("<span size='large' weight='bold' foreground='#cdd6f4'>No Media Playing</span>")
        box_empty.pack_start(lbl_empty_title, False, False, 0)

        lbl_empty_desc = Gtk.Label()
        lbl_empty_desc.set_markup("<small><span foreground='#a6adc8'>Start Spotify or another media player\nto control playback here.</span></small>")
        lbl_empty_desc.set_justify(Gtk.Justification.CENTER)
        box_empty.pack_start(lbl_empty_desc, False, False, 0)

        self.content_stack.add_named(box_empty, "empty")

        # Page 2: Active player
        self.box_player = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.build_player_ui(self.box_player)
        self.content_stack.add_named(self.box_player, "player")

        # Bottom Bar (Material 3 Status & Volume)
        self.status_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.status_bar.get_style_context().add_class("status-bar")

        self.btn_player_chip = Gtk.Button()
        self.btn_player_chip.get_style_context().add_class("player-chip")
        self.btn_player_chip.set_tooltip_text("Click to focus media player")
        self.btn_player_chip.connect("clicked", self.on_player_chip_clicked)
        self.chip_player = Gtk.Label()
        self.chip_player.set_markup("<span foreground='#a6e3a1'>●</span> Media")
        self.btn_player_chip.add(self.chip_player)
        self.status_bar.pack_start(self.btn_player_chip, False, False, 0)

        self.lbl_footer = Gtk.Label(label="Ready")
        self.lbl_footer.set_ellipsize(Pango.EllipsizeMode.END)
        self.status_bar.pack_start(self.lbl_footer, True, True, 0)

        # Volume Indicator / Quick Control (wrapped in EventBox so Wayland/GTK scroll events work)
        self.vol_event = Gtk.EventBox()
        self.vol_event.set_visible_window(False)
        self.vol_event.add_events(Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.vol_event.connect("scroll-event", self.on_volume_scroll)
        self.vol_event.set_tooltip_text("Scroll to adjust media volume")

        vol_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        vol_box.get_style_context().add_class("vol-chip")
        self.img_vol = Gtk.Image.new_from_icon_name("audio-volume-medium-symbolic", Gtk.IconSize.BUTTON)
        self.img_vol.set_pixel_size(14)
        self.lbl_volume = Gtk.Label(label="%100")
        self.lbl_volume.get_style_context().add_class("time-label")
        vol_box.pack_start(self.img_vol, False, False, 0)
        vol_box.pack_start(self.lbl_volume, False, False, 0)
        self.vol_event.add(vol_box)
        self.status_bar.pack_end(self.vol_event, False, False, 0)

        main_box.pack_end(self.status_bar, False, False, 0)

        self.show_all()
        self.set_focus(None)

        def _init_media():
            if os.environ.get("MEDIA_PREVIEW") == "1":
                self.content_stack.set_visible_child_name("player")
                self.header.set_subtitle("Spotify  •  Çalıyor")
                self.chip_player.set_markup("<span foreground='#a6e3a1'>●</span> Spotify")
                self.lbl_title.set_text("Drive, Don't Talk")
                self.lbl_artist.set_text("Makeout Reef")
                self.lbl_album.set_text("Star Power")
                self.img_play.set_from_icon_name("media-playback-pause-symbolic", Gtk.IconSize.BUTTON)
                self.btn_shuffle.get_style_context().add_class("active")
                self.scale_time.set_value(42.0)
                self.lbl_curr_time.set_text("1:14")
                self.lbl_tot_time.set_text("2:55")
                self.lbl_footer.set_text("Makeout Reef - Drive, Don't Talk")
                self.lbl_volume.set_text("%80")
                return False
            self.refresh_media_state()
            self.refresh_volume()
            return False

        GLib.idle_add(_init_media)
        if os.environ.get("MEDIA_PREVIEW") != "1":
            GLib.timeout_add_seconds(1, self.refresh_media_state)

    def on_focus_out(self, widget, event):
        return False

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def build_player_ui(self, box):
        # Card with Art & Info
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        card.get_style_context().add_class("media-card")

        # Icon / Album art
        art_center = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        art_center.set_halign(Gtk.Align.CENTER)
        self.img_art = Gtk.Image.new_from_icon_name("audio-x-generic-symbolic", Gtk.IconSize.DIALOG)
        self.img_art.set_pixel_size(84)
        self.img_art.get_style_context().add_class("art-box")
        art_center.pack_start(self.img_art, False, False, 0)
        card.pack_start(art_center, False, False, 2)

        # Track title
        self.lbl_title = Gtk.Label()
        self.lbl_title.get_style_context().add_class("track-title")
        self.lbl_title.set_ellipsize(Pango.EllipsizeMode.END)
        self.lbl_title.set_max_width_chars(28)
        card.pack_start(self.lbl_title, False, False, 0)

        # Track artist
        self.lbl_artist = Gtk.Label()
        self.lbl_artist.get_style_context().add_class("track-artist")
        self.lbl_artist.set_ellipsize(Pango.EllipsizeMode.END)
        self.lbl_artist.set_max_width_chars(32)
        card.pack_start(self.lbl_artist, False, False, 0)

        # Track album
        self.lbl_album = Gtk.Label()
        self.lbl_album.get_style_context().add_class("track-album")
        self.lbl_album.set_ellipsize(Pango.EllipsizeMode.END)
        self.lbl_album.set_max_width_chars(34)
        card.pack_start(self.lbl_album, False, False, 0)

        box.pack_start(card, False, False, 0)

        # Timeline Slider & Timestamps
        time_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        time_box.set_margin_start(16)
        time_box.set_margin_end(16)

        self.scale_time = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale_time.set_draw_value(False)
        self.scale_time.connect("change-value", self.on_time_scale_change)
        time_box.pack_start(self.scale_time, False, False, 0)

        lbls_time = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.lbl_curr_time = Gtk.Label(label="0:00")
        self.lbl_curr_time.get_style_context().add_class("time-label")
        self.lbl_tot_time = Gtk.Label(label="0:00")
        self.lbl_tot_time.get_style_context().add_class("time-label")
        lbls_time.pack_start(self.lbl_curr_time, False, False, 0)
        lbls_time.pack_end(self.lbl_tot_time, False, False, 0)
        time_box.pack_start(lbls_time, False, False, 0)

        box.pack_start(time_box, False, False, 0)

        # Material 3 Media Controls: [ Shuffle ] [ Prev ] [ Play/Pause ] [ Next ] [ Repeat ]
        ctrl_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        ctrl_box.set_halign(Gtk.Align.CENTER)
        ctrl_box.set_valign(Gtk.Align.CENTER)
        ctrl_box.set_margin_top(6)
        ctrl_box.set_margin_bottom(8)

        # 1. Shuffle Button
        self.btn_shuffle = Gtk.Button()
        self.img_shuffle = Gtk.Image.new_from_icon_name("media-playlist-shuffle-symbolic", Gtk.IconSize.BUTTON)
        self.img_shuffle.set_pixel_size(15)
        self.btn_shuffle.set_image(self.img_shuffle)
        self.btn_shuffle.get_style_context().add_class("btn-m3-ghost")
        self.btn_shuffle.set_tooltip_text("Shuffle Playback (On/Off)")
        self.btn_shuffle.connect("clicked", lambda b: self.toggle_shuffle())
        self.btn_shuffle.set_valign(Gtk.Align.CENTER)
        ctrl_box.pack_start(self.btn_shuffle, False, False, 0)

        # 2. Previous Button
        self.btn_prev = Gtk.Button()
        self.img_prev = Gtk.Image.new_from_icon_name("media-skip-backward-symbolic", Gtk.IconSize.BUTTON)
        self.img_prev.set_pixel_size(16)
        self.btn_prev.set_image(self.img_prev)
        self.btn_prev.get_style_context().add_class("btn-m3-tonal")
        self.btn_prev.set_tooltip_text("Previous Track")
        self.btn_prev.connect("clicked", lambda b: subprocess.Popen(["playerctl", "previous"]))
        self.btn_prev.set_valign(Gtk.Align.CENTER)
        ctrl_box.pack_start(self.btn_prev, False, False, 0)

        # 3. Play / Pause Button (M3 Prominent FAB)
        self.btn_play = Gtk.Button()
        self.img_play = Gtk.Image.new_from_icon_name("media-playback-start-symbolic", Gtk.IconSize.BUTTON)
        self.img_play.set_pixel_size(24)
        self.btn_play.set_image(self.img_play)
        self.btn_play.get_style_context().add_class("btn-m3-play")
        self.btn_play.set_tooltip_text("Play / Pause")
        self.btn_play.connect("clicked", lambda b: subprocess.Popen(["playerctl", "play-pause"]))
        self.btn_play.set_valign(Gtk.Align.CENTER)
        ctrl_box.pack_start(self.btn_play, False, False, 0)

        # 4. Next Button
        self.btn_next = Gtk.Button()
        self.img_next = Gtk.Image.new_from_icon_name("media-skip-forward-symbolic", Gtk.IconSize.BUTTON)
        self.img_next.set_pixel_size(16)
        self.btn_next.set_image(self.img_next)
        self.btn_next.get_style_context().add_class("btn-m3-tonal")
        self.btn_next.set_tooltip_text("Next Track")
        self.btn_next.connect("clicked", lambda b: subprocess.Popen(["playerctl", "next"]))
        self.btn_next.set_valign(Gtk.Align.CENTER)
        ctrl_box.pack_start(self.btn_next, False, False, 0)

        # 5. Repeat / Loop Button
        self.btn_loop = Gtk.Button()
        self.img_loop = Gtk.Image.new_from_icon_name("media-playlist-repeat-symbolic", Gtk.IconSize.BUTTON)
        self.img_loop.set_pixel_size(15)
        self.btn_loop.set_image(self.img_loop)
        self.btn_loop.get_style_context().add_class("btn-m3-ghost")
        self.btn_loop.set_tooltip_text("Repeat Mode (Off / Playlist / Track)")
        self.btn_loop.connect("clicked", lambda b: self.cycle_loop())
        self.btn_loop.set_valign(Gtk.Align.CENTER)
        ctrl_box.pack_start(self.btn_loop, False, False, 0)

        box.pack_start(ctrl_box, False, False, 0)

    def toggle_shuffle(self):
        try:
            subprocess.run(["playerctl", "shuffle", "Toggle"], timeout=0.3)
            GLib.timeout_add(100, self.update_playback_modes)
        except Exception:
            pass

    def cycle_loop(self):
        try:
            res_loop = subprocess.run(["playerctl", "loop"], capture_output=True, text=True, timeout=0.2)
            curr = res_loop.stdout.strip().capitalize() if res_loop.returncode == 0 else "None"
            next_state = "Playlist" if curr == "None" else ("Track" if curr == "Playlist" else "None")
            subprocess.run(["playerctl", "loop", next_state], timeout=0.3)
            GLib.timeout_add(100, self.update_playback_modes)
        except Exception:
            pass

    def update_playback_modes(self, is_shuf=None, loop_val=None):
        try:
            if is_shuf is None:
                res_shuf = subprocess.run(["playerctl", "shuffle"], capture_output=True, text=True, timeout=0.15)
                is_shuf = (res_shuf.stdout.strip().lower() in ("on", "true")) if res_shuf.returncode == 0 else False
            ctx_shuf = self.btn_shuffle.get_style_context()
            if is_shuf:
                ctx_shuf.add_class("active")
                self.btn_shuffle.set_tooltip_text("Shuffle: On")
            else:
                ctx_shuf.remove_class("active")
                self.btn_shuffle.set_tooltip_text("Shuffle: Off")
        except Exception:
            pass

        try:
            if loop_val is None:
                res_loop = subprocess.run(["playerctl", "loop"], capture_output=True, text=True, timeout=0.15)
                loop_val = res_loop.stdout.strip().capitalize() if res_loop.returncode == 0 else "None"
            ctx_loop = self.btn_loop.get_style_context()
            if loop_val == "Track":
                ctx_loop.add_class("active")
                self.img_loop.set_from_icon_name("media-playlist-repeat-song-symbolic", Gtk.IconSize.BUTTON)
                self.btn_loop.set_tooltip_text("Repeat: Single Track")
            elif loop_val == "Playlist":
                ctx_loop.add_class("active")
                self.img_loop.set_from_icon_name("media-playlist-repeat-symbolic", Gtk.IconSize.BUTTON)
                self.btn_loop.set_tooltip_text("Repeat: Playlist")
            else:
                ctx_loop.remove_class("active")
                self.img_loop.set_from_icon_name("media-playlist-repeat-symbolic", Gtk.IconSize.BUTTON)
                self.btn_loop.set_tooltip_text("Repeat: Off")
        except Exception:
            pass

    def on_player_chip_clicked(self, button):
        player = (self.current_player_name or "").strip().lower()
        if not player or player == "idle":
            return
        try:
            res = subprocess.check_output(["hyprctl", "clients", "-j"], timeout=0.2).decode()
            clients = json.loads(res)
            base_player = player.split(".")[0]
            target = None
            # 1. Exact class or initialClass match
            for c in clients:
                c_cls = (c.get("class") or "").lower()
                c_init = (c.get("initialClass") or "").lower()
                if base_player in (c_cls, c_init) or player in (c_cls, c_init):
                    target = c
                    break
            # 2. Substring match in class, initialClass, or title
            if not target:
                for c in clients:
                    c_cls = (c.get("class") or "").lower()
                    c_init = (c.get("initialClass") or "").lower()
                    c_title = (c.get("title") or "").lower()
                    if base_player in c_cls or base_player in c_init or base_player in c_title:
                        target = c
                        break
            if target and target.get("address"):
                addr = target["address"]
                self.hide()
                self.close()
                subprocess.Popen(
                    ["sh", "-c", f"sleep 0.04; hyprctl eval \"hl.config({{ input = {{ follow_mouse = 1 }}, cursor = {{ no_warps = true }} }}); hl.dispatch(hl.dsp.focus({{ window = 'address:{addr}' }})); hl.config({{ cursor = {{ no_warps = false }} }})\""],
                    start_new_session=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
        except Exception:
            pass

    def _update_volume_ui(self, vol_pct):
        vol_pct = max(0, min(100, int(round(vol_pct))))
        self.current_volume_pct = vol_pct
        self.lbl_volume.set_text(f"%{vol_pct}")
        icon_name = (
            "audio-volume-muted-symbolic" if vol_pct == 0 else
            ("audio-volume-low-symbolic" if vol_pct < 35 else
             ("audio-volume-medium-symbolic" if vol_pct < 70 else "audio-volume-high-symbolic"))
        )
        self.img_vol.set_from_icon_name(icon_name, Gtk.IconSize.BUTTON)

    def _apply_player_volume_async(self, target_pct, step_dir):
        def _worker():
            # 1. Try MPRIS player volume directly (e.g. Spotify, VLC, MPV)
            try:
                res = subprocess.run(
                    ["playerctl", "volume", f"{target_pct / 100.0:.2f}"],
                    capture_output=True, timeout=0.25
                )
                if res.returncode == 0:
                    return
            except Exception:
                pass
            # 2. Fallback: PipeWire/PulseAudio sink-input matching active player
            player = (self.current_player_name or "").strip().lower().split(".")[0]
            if player:
                try:
                    out = subprocess.check_output(["pactl", "list", "sink-inputs"], timeout=0.25).decode("utf-8", errors="ignore")
                    curr_id = None
                    for line in out.splitlines():
                        s = line.strip()
                        if s.startswith("Sink Input #"):
                            curr_id = s.split("#", 1)[1].strip()
                        elif curr_id and (f'"{player}' in s.lower() or f'= "{player}' in s.lower()):
                            subprocess.run(["pactl", "set-sink-input-volume", curr_id, f"{target_pct}%"], timeout=0.2)
                            return
                except Exception:
                    pass
            # 3. Final fallback: system volume via pamixer
            try:
                flag = "-i" if step_dir > 0 else "-d"
                subprocess.run(["pamixer", flag, "5"], timeout=0.2)
            except Exception:
                pass
        threading.Thread(target=_worker, daemon=True).start()

    def on_volume_scroll(self, widget, event):
        step = 0
        if event.direction == Gdk.ScrollDirection.UP:
            step = 1
        elif event.direction == Gdk.ScrollDirection.DOWN:
            step = -1
        elif event.direction == Gdk.ScrollDirection.SMOOTH:
            ok, _dx, dy = event.get_scroll_deltas()
            if ok:
                self._vol_scroll_acc += dy
                if self._vol_scroll_acc <= -0.35:
                    step = 1
                    self._vol_scroll_acc = 0.0
                elif self._vol_scroll_acc >= 0.35:
                    step = -1
                    self._vol_scroll_acc = 0.0
        if step != 0:
            self._last_vol_scroll_time = time.time()
            new_pct = max(0, min(100, self.current_volume_pct + step * 5))
            self._update_volume_ui(new_pct)
            self._apply_player_volume_async(new_pct, step)
            return True
        return False

    def refresh_volume(self):
        try:
            res = subprocess.run(["playerctl", "volume"], capture_output=True, text=True, timeout=0.2)
            if res.returncode == 0 and res.stdout.strip():
                vol_f = float(res.stdout.strip())
                self._update_volume_ui(vol_f * 100.0)
                return
        except Exception:
            pass
        # Fallback to pamixer
        try:
            res = subprocess.run(["pamixer", "--get-volume"], capture_output=True, text=True, timeout=0.2)
            if res.returncode == 0:
                self._update_volume_ui(int(res.stdout.strip()))
        except Exception:
            pass

    def on_time_scale_change(self, scale, scroll_type, value):
        if self.track_length > 0:
            target_sec = int((value / 100.0) * self.track_length)
            subprocess.run(["playerctl", "position", str(target_sec)])
        return False

    def format_seconds(self, sec):
        sec = max(0, int(sec))
        m, s = divmod(sec, 60)
        h, m = divmod(m, 60)
        if h > 0:
            return f"{h}:{m:02d}:{s:02d}"
        return f"{m}:{s:02d}"

    def load_rounded_cover(self, file_path):
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(file_path, 84, 84, True)
            w, h, radius = pixbuf.get_width(), pixbuf.get_height(), 14
            surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
            ctx = cairo.Context(surface)
            ctx.arc(w - radius, radius, radius, -math.pi/2, 0)
            ctx.arc(w - radius, h - radius, radius, 0, math.pi/2)
            ctx.arc(radius, h - radius, radius, math.pi/2, math.pi)
            ctx.arc(radius, radius, radius, math.pi, 3*math.pi/2)
            ctx.close_path()
            ctx.clip()
            Gdk.cairo_set_source_pixbuf(ctx, pixbuf, 0, 0)
            ctx.paint()
            return Gdk.pixbuf_get_from_surface(surface, 0, 0, w, h)
        except Exception:
            try:
                return GdkPixbuf.Pixbuf.new_from_file_at_scale(file_path, 84, 84, True)
            except Exception:
                return None

    def update_art_from_file(self, file_path, art_url):
        if self.current_art_url == art_url:
            rounded = self.load_rounded_cover(file_path)
            if rounded:
                self.img_art.set_from_pixbuf(rounded)
            else:
                self.img_art.set_from_icon_name("audio-x-generic-symbolic", Gtk.IconSize.DIALOG)

    def fetch_art_async(self, art_url):
        cache_dir = os.path.expanduser("~/.cache/media-player-art")
        os.makedirs(cache_dir, exist_ok=True)
        url_hash = hashlib.md5(art_url.encode('utf-8')).hexdigest()
        cache_path = os.path.join(cache_dir, f"{url_hash}.jpg")

        if os.path.exists(cache_path) and os.path.getsize(cache_path) > 0:
            self.update_art_from_file(cache_path, art_url)
            return

        def _worker():
            try:
                req = urllib.request.Request(art_url, headers={'User-Agent': 'Mozilla/5.0'})
                with urllib.request.urlopen(req, timeout=5) as resp:
                    data = resp.read()
                    with open(cache_path, "wb") as f:
                        f.write(data)
                GLib.idle_add(self.update_art_from_file, cache_path, art_url)
            except Exception:
                pass

        threading.Thread(target=_worker, daemon=True).start()

    def refresh_media_state(self):
        try:
            # Single ultra-fast batch metadata call (fetches status, metadata, loop, shuffle, volume all-in-one in ~5ms)
            meta_res = subprocess.run(
                ["playerctl", "metadata", "--format", "{{playerName}}///{{status}}///{{title}}///{{artist}}///{{album}}///{{mpris:length}}///{{position}}///{{mpris:artUrl}}///{{loop}}///{{shuffle}}///{{volume}}"],
                capture_output=True, text=True, timeout=0.25
            )
            if meta_res.returncode != 0 or not meta_res.stdout.strip():
                self.content_stack.set_visible_child_name("empty")
                self.header.set_subtitle("No Active Player")
                self.current_player_name = None
                self.chip_player.set_markup("<span foreground='#6c7086'>○</span> Idle")
                self.lbl_footer.set_text("Waiting for media player...")
                self.current_art_url = None
                self.img_art.set_from_icon_name("audio-x-generic-symbolic", Gtk.IconSize.DIALOG)
                return True

            parts = meta_res.stdout.strip().split("///")
            if len(parts) >= 6:
                player_name = parts[0]
                status = parts[1]
                title = parts[2]
                artist = parts[3]
                album = parts[4]
                length_raw = parts[5]
                pos_raw = parts[6] if len(parts) > 6 else "0"
                art_url = parts[7].strip() if len(parts) > 7 else ""
                loop_val = parts[8].strip().capitalize() if len(parts) > 8 else "None"
                shuf_val = parts[9].strip().lower() if len(parts) > 9 else "false"
                vol_raw = parts[10].strip() if len(parts) > 10 else ""

                self.current_player_name = player_name
                self.content_stack.set_visible_child_name("player")
                status_icon = "●" if status == "Playing" else "○"
                status_color = "#a6adc8"
                status_text = "Playing" if status == "Playing" else "Paused"
                self.header.set_subtitle(f"{player_name.capitalize()}  •  {status_text}")
                self.chip_player.set_markup(f"<span foreground='{status_color}'>{status_icon}</span> {player_name.capitalize()}")
                self.btn_player_chip.set_tooltip_text(f"Focus {player_name.capitalize()}")

                if vol_raw and (time.time() - self._last_vol_scroll_time) > 1.0:
                    try:
                        self._update_volume_ui(float(vol_raw) * 100.0)
                    except Exception:
                        pass
                self.lbl_title.set_text(title or "Unknown Title")
                self.lbl_artist.set_text(artist or "Unknown Artist")
                self.lbl_album.set_text(album or "")

                # Play/Pause Icon
                icon_name = "media-playback-pause-symbolic" if status == "Playing" else "media-playback-start-symbolic"
                self.img_play.set_from_icon_name(icon_name, Gtk.IconSize.BUTTON)

                # Playback modes (instant in-memory, 0 subprocess)
                self.update_playback_modes(is_shuf=(shuf_val in ("true", "on")), loop_val=loop_val)

                # Album Cover Art
                if art_url != self.current_art_url:
                    self.current_art_url = art_url
                    if art_url:
                        if art_url.startswith("file://"):
                            local_file = urllib.parse.unquote(art_url[7:])
                            self.update_art_from_file(local_file, art_url)
                        elif art_url.startswith("http://") or art_url.startswith("https://"):
                            self.fetch_art_async(art_url)
                        else:
                            self.update_art_from_file(art_url, art_url)
                    else:
                        self.img_art.set_from_icon_name("audio-x-generic-symbolic", Gtk.IconSize.DIALOG)

                # Position & Length (MPRIS specifies length and position in microseconds)
                try:
                    length_sec = int(length_raw) / 1000000.0 if (length_raw and length_raw.isdigit()) else 0
                    if pos_raw:
                        pos_val = float(pos_raw)
                        pos_sec = (pos_val / 1000000.0) if pos_val > 10000 else pos_val
                    else:
                        pos_sec = 0
                    self.track_length = length_sec

                    if length_sec > 0:
                        pct = min(max((pos_sec / length_sec) * 100.0, 0.0), 100.0)
                        self.scale_time.set_value(pct)
                        self.lbl_curr_time.set_text(self.format_seconds(pos_sec))
                        self.lbl_tot_time.set_text(self.format_seconds(length_sec))
                        self.scale_time.set_sensitive(True)
                    else:
                        self.scale_time.set_value(0)
                        self.lbl_curr_time.set_text(self.format_seconds(pos_sec))
                        self.lbl_tot_time.set_text("--:--")
                        self.scale_time.set_sensitive(False)
                except Exception:
                    pass
                self.lbl_footer.set_text(f"{artist} - {title}" if artist else title)
            else:
                self.content_stack.set_visible_child_name("empty")
                self.current_art_url = None
                self.img_art.set_from_icon_name("audio-x-generic-symbolic", Gtk.IconSize.DIALOG)
        except Exception:
            self.content_stack.set_visible_child_name("empty")
            self.current_art_url = None
            self.img_art.set_from_icon_name("audio-x-generic-symbolic", Gtk.IconSize.DIALOG)

        return True


class MediaPlayerApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="org.antigravity.mediaplayer",
            flags=Gio.ApplicationFlags.NON_UNIQUE
        )
        self.window = None

    def do_activate(self):
        if not self.window:
            css_provider = Gtk.CssProvider()
            css_provider.load_from_data(SmartFocus.get_themed_css(CSS_STYLE))
            screen = Gdk.Screen.get_default()
            Gtk.StyleContext.add_provider_for_screen(
                screen,
                css_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

            self.window = MediaPlayerWindow(self)
            self.window.connect('destroy', lambda w: setattr(self, 'window', None))
            self.window.present()
        else:
            self.window.close()
            self.window = None


if __name__ == "__main__":
    app = MediaPlayerApp()
    sys.exit(app.run(sys.argv))
