from waybar_focus import SmartFocus, fast_toggle_or_lock
fast_toggle_or_lock("wifi-manager")

import sys
import os
import subprocess
import threading
import time
import gi

gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib, Gio, Pango
GLib.set_prgname("wifi-manager")

