class WifiManagerWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(title="Wi-Fi Manager", application=app)
        self.set_default_size(380, 440)

        self.networks = []
        self.saved_connections = set()
        self.is_scanning = False
        self.wifi_enabled = True
        self.current_connected_ssid = None
        self.ip_address = ""

        # Close on Escape key
        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", self.on_focus_out)
        self.ready_to_close = False
        GLib.timeout_add(250, lambda: setattr(self, "ready_to_close", True) or False)
        try:
            from waybar_focus import SmartFocus
            SmartFocus.setup(self, align="right", offset=306)
        except Exception:
            pass

        # Main Box
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_box)

        # HeaderBar
        self.header = Gtk.HeaderBar()
        self.header.set_show_close_button(True)
        self.header.set_title("Wi-Fi Manager")
        self.header.set_subtitle("Scanning networks...")
        self.set_titlebar(self.header)

        # Wi-Fi Power Switch
        self.switch_wifi = Gtk.Switch()
        self.switch_wifi.set_valign(Gtk.Align.CENTER)
        self.switch_wifi.set_tooltip_text("Toggle Wi-Fi")
        self.switch_wifi.connect("notify::active", self.on_wifi_switch_toggled)
        self.header.pack_start(self.switch_wifi)

        # Refresh / Rescan Button
        self.btn_refresh = Gtk.Button.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON)
        self.btn_refresh.set_tooltip_text("Refresh Networks (Rescan)")
        self.btn_refresh.connect("clicked", lambda b: self.start_scan(rescan=True))
        self.header.pack_start(self.btn_refresh)

        # Spinner in Header
        self.spinner = Gtk.Spinner()
        self.header.pack_start(self.spinner)

        # Advanced Settings Button (nm-connection-editor)
        self.btn_settings = Gtk.Button.new_from_icon_name("preferences-system-symbolic", Gtk.IconSize.BUTTON)
        self.btn_settings.set_tooltip_text("Advanced Network Settings (nm-connection-editor)")
        self.btn_settings.connect("clicked", lambda b: subprocess.Popen(["nm-connection-editor"]))
        self.header.pack_end(self.btn_settings)

        # InfoBar for Messages/Errors
        self.infobar = Gtk.InfoBar()
        self.infobar_label = Gtk.Label()
        self.infobar.get_content_area().add(self.infobar_label)
        self.infobar.set_show_close_button(True)
        self.infobar.connect("response", lambda ib, r: ib.hide())
        self.infobar.set_no_show_all(True)
        main_box.pack_start(self.infobar, False, False, 0)

        # Search Entry
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_can_focus(True)
        self.search_entry.get_style_context().add_class("search-box")
        self.search_entry.set_placeholder_text("Search networks...")
        self.search_entry.connect("search-changed", self.on_search_changed)
        main_box.pack_start(self.search_entry, False, False, 0)

        # Scrolled Window + ListBox
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        main_box.pack_start(scrolled, True, True, 0)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.set_filter_func(self.filter_network_row)
        scrolled.add(self.listbox)

        # Bottom Status Bar
        self.status_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.status_box.get_style_context().add_class("status-bar")
        self.lbl_status_left = Gtk.Label(label="Loading status...")
        self.lbl_status_right = Gtk.Label(label="")
        self.status_box.pack_start(self.lbl_status_left, False, False, 0)
        self.status_box.pack_end(self.lbl_status_right, False, False, 0)
        main_box.pack_end(self.status_box, False, False, 0)

        self.show_all()
        self.set_focus(None)

        def _init_wifi():
            self.start_scan(rescan=False)
            return False

        GLib.idle_add(_init_wifi)

        # Periodic auto-scan every 25 seconds
        GLib.timeout_add_seconds(25, self.on_auto_scan_timer)

    def on_focus_out(self, widget, event):
        return False

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def on_auto_scan_timer(self):
        if self.get_visible() and self.wifi_enabled and not self.is_scanning:
            self.start_scan(rescan=False)
        return True

    def show_info(self, message, message_type=Gtk.MessageType.INFO):
        self.infobar.set_message_type(message_type)
        self.infobar_label.set_text(message)
        self.infobar.show_all()

    def check_initial_state(self):
        try:
            res = subprocess.run(["nmcli", "radio", "wifi"], capture_output=True, text=True)
            self.wifi_enabled = "enabled" in res.stdout.strip()
            self.switch_wifi.handler_block_by_func(self.on_wifi_switch_toggled)
            self.switch_wifi.set_active(self.wifi_enabled)
            self.switch_wifi.handler_unblock_by_func(self.on_wifi_switch_toggled)
        except Exception:
            pass

    def on_wifi_switch_toggled(self, switch, gparam):
        state = switch.get_active()
        self.wifi_enabled = state
        cmd = "on" if state else "off"
        def toggle_thread():
            subprocess.run(["nmcli", "radio", "wifi", cmd])
            GLib.idle_add(lambda: self.start_scan(rescan=True) if state else self.clear_list("Wi-Fi Off"))
        threading.Thread(target=toggle_thread, daemon=True).start()

    def clear_list(self, msg=""):
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        self.header.set_subtitle(msg)
        self.lbl_status_left.set_text("Wi-Fi disabled")
        self.lbl_status_right.set_text("")

    def start_scan(self, rescan=True):
        if self.is_scanning or not self.wifi_enabled:
            return
        self.is_scanning = True
        self.spinner.start()
        self.btn_refresh.set_sensitive(False)
        self.header.set_subtitle("Scanning networks...")

        threading.Thread(target=self._scan_worker, args=(rescan,), daemon=True).start()

    def _scan_worker(self, rescan):
        # Sync wifi switch state in background
        try:
            res_rad = subprocess.run(["nmcli", "radio", "wifi"], capture_output=True, text=True)
            is_enabled = "enabled" in res_rad.stdout.strip()
            self.wifi_enabled = is_enabled
            def _sync():
                self.switch_wifi.handler_block_by_func(self.on_wifi_switch_toggled)
                self.switch_wifi.set_active(is_enabled)
                self.switch_wifi.handler_unblock_by_func(self.on_wifi_switch_toggled)
            GLib.idle_add(_sync)
            if not is_enabled:
                GLib.idle_add(self.clear_list, "Wi-Fi Off")
                return
        except Exception:
            pass

        if rescan:
            try:
                subprocess.run(["nmcli", "device", "wifi", "rescan"], capture_output=True)
            except Exception:
                pass

        # 1. Fetch saved connections
        saved = set()
        try:
            res_saved = subprocess.run(
                ["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"],
                capture_output=True, text=True
            )
            for line in res_saved.stdout.splitlines():
                parts = line.split(":")
                if len(parts) >= 2 and "wireless" in parts[1]:
                    saved.add(parts[0])
        except Exception:
            pass

        # 2. Fetch IP & Connected interface status
        ip_addr = ""
        current_conn = None
        ifname = self.get_wifi_ifname()
        try:
            res_dev = subprocess.run(
                ["nmcli", "-t", "-f", "GENERAL.CONNECTION,IP4.ADDRESS", "device", "show", ifname],
                capture_output=True, text=True
            )
            for line in res_dev.stdout.splitlines():
                if line.startswith("GENERAL.CONNECTION:"):
                    conn = line.split(":", 1)[1].strip()
                    if conn and conn != "--":
                        current_conn = conn
                elif line.startswith("IP4.ADDRESS"):
                    ip_addr = line.split(":", 1)[1].strip()
        except Exception:
            pass

        # 3. Fetch Wi-Fi networks
        networks_dict = {}
        try:
            res_wifi = subprocess.run(
                ["nmcli", "-m", "multiline", "-f", "IN-USE,BSSID,SSID,MODE,CHAN,FREQ,RATE,SIGNAL,BARS,SECURITY", "device", "wifi", "list"],
                capture_output=True, text=True
            )
            current = {}
            for line in res_wifi.stdout.splitlines():
                if ": " in line:
                    k, v = line.split(": ", 1)
                    k = k.strip()
                    v = v.strip()
                    if k == "IN-USE" and current:
                        self._process_raw_network(current, networks_dict)
                        current = {}
                    current[k] = v
            if current:
                self._process_raw_network(current, networks_dict)
        except Exception:
            pass

        # Convert dict to list
        parsed_networks = list(networks_dict.values())

        # Sort: connected first, then saved, then by signal strength desc
        def sort_key(net):
            in_use = 1 if net["in_use"] else 0
            is_saved = 1 if net["ssid"] in saved else 0
            return (in_use, is_saved, net["signal"])

        parsed_networks.sort(key=sort_key, reverse=True)

        GLib.idle_add(self._scan_complete, parsed_networks, saved, current_conn, ip_addr)

    def _process_raw_network(self, raw, networks_dict):
        ssid = raw.get("SSID", "").strip()
        if not ssid or ssid == "--":
            return

        in_use = raw.get("IN-USE", "") == "*"
        try:
            signal = int(raw.get("SIGNAL", "0"))
        except ValueError:
            signal = 0

        freq_str = raw.get("FREQ", "")
        band = "5 GHz" if ("5" in freq_str and "MHz" in freq_str and int(freq_str.split()[0]) > 4000) else "2.4 GHz"
        sec = raw.get("SECURITY", "").strip()
        if sec == "--":
            sec = ""

        if ssid in networks_dict:
            existing = networks_dict[ssid]
            if in_use:
                existing["in_use"] = True
            if signal > existing["signal"]:
                existing["signal"] = signal
                existing["rate"] = raw.get("RATE", existing["rate"])
                existing["chan"] = raw.get("CHAN", existing["chan"])
            existing["bands"].add(band)
            if not existing["security"] and sec:
                existing["security"] = sec
        else:
            networks_dict[ssid] = {
                "ssid": ssid,
                "in_use": in_use,
                "signal": signal,
                "rate": raw.get("RATE", ""),
                "chan": raw.get("CHAN", ""),
                "bands": {band},
                "security": sec,
                "bssid": raw.get("BSSID", "")
            }

    def _scan_complete(self, networks, saved, current_conn, ip_addr):
        self.is_scanning = False
        self.spinner.stop()
        self.btn_refresh.set_sensitive(True)
        self.networks = networks
        self.saved_connections = saved
        self.current_connected_ssid = current_conn
        self.ip_address = ip_addr

        # Update subtitle & status
        if current_conn:
            self.header.set_subtitle(f"Connected: {current_conn}")
            ip_text = f" | IP: {ip_addr}" if ip_addr else ""
            self.lbl_status_left.set_text(f"Connected: {current_conn}{ip_text}")
        else:
            self.header.set_subtitle("No Connection")
            self.lbl_status_left.set_text("No connection")

        self.lbl_status_right.set_text(f"{len(networks)} networks found")

        # Repopulate list
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        for net in networks:
            row = self.create_network_row(net)
            self.listbox.add(row)

        self.listbox.show_all()

    def get_signal_icon(self, signal):
        if signal >= 75:
            return "network-wireless-signal-excellent-symbolic"
        elif signal >= 50:
            return "network-wireless-signal-good-symbolic"
        elif signal >= 25:
            return "network-wireless-signal-ok-symbolic"
        elif signal > 0:
            return "network-wireless-signal-weak-symbolic"
        return "network-wireless-signal-none-symbolic"

    def create_network_row(self, net):
        row = Gtk.ListBoxRow()
        row.ssid = net["ssid"]

        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        hbox.set_margin_top(6)
        hbox.set_margin_bottom(6)
        hbox.set_margin_start(10)
        hbox.set_margin_end(10)

        # Signal Icon
        icon_name = self.get_signal_icon(net["signal"])
        img_signal = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DND)
        img_signal.set_pixel_size(20)
        hbox.pack_start(img_signal, False, False, 0)

        # Details VBox
        vbox_info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        hbox.pack_start(vbox_info, True, True, 0)

        # Title Row (SSID + Lock + Saved badge)
        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        vbox_info.pack_start(title_box, False, False, 0)

        lbl_ssid = Gtk.Label()
        lbl_ssid.set_markup(f"<b>{GLib.markup_escape_text(net['ssid'])}</b>")
        lbl_ssid.set_halign(Gtk.Align.START)
        title_box.pack_start(lbl_ssid, False, False, 0)

        if net["security"]:
            img_lock = Gtk.Image.new_from_icon_name("network-wireless-encrypted-symbolic", Gtk.IconSize.MENU)
            img_lock.set_tooltip_text(f"Secured Network: {net['security']}")
            title_box.pack_start(img_lock, False, False, 0)

        if net["ssid"] in self.saved_connections and not net["in_use"]:
            lbl_saved = Gtk.Label(label="Saved")
            lbl_saved.get_style_context().add_class("badge-saved")
            title_box.pack_start(lbl_saved, False, False, 0)

        # Subtitle Row (Signal % • Band • Security)
        bands_str = "/".join(sorted(net["bands"]))
        if self.is_enterprise_network(net):
            sec_str = f"{net['security']} (Enterprise 802.1X)" if net["security"] else "Enterprise 802.1X"
        else:
            sec_str = net["security"] if net["security"] else "Open Network"
        detail_text = f"%{net['signal']}  •  {bands_str}  •  {sec_str}"
        lbl_details = Gtk.Label()
        lbl_details.set_markup(f"<small><span alpha='65%'>{GLib.markup_escape_text(detail_text)}</span></small>")
        lbl_details.set_halign(Gtk.Align.START)
        vbox_info.pack_start(lbl_details, False, False, 0)

        # Right Action Widgets
        if net["in_use"]:
            lbl_connected = Gtk.Label(label="Connected")
            lbl_connected.get_style_context().add_class("badge-connected")
            lbl_connected.set_valign(Gtk.Align.CENTER)
            hbox.pack_end(lbl_connected, False, False, 4)

            btn_disconnect = Gtk.Button(label="Disconnect")
            btn_disconnect.get_style_context().add_class("btn-disconnect")
            btn_disconnect.set_valign(Gtk.Align.CENTER)
            btn_disconnect.connect("clicked", lambda b: self.disconnect_network())
            hbox.pack_end(btn_disconnect, False, False, 4)
        else:
            btn_connect = Gtk.Button(label="Connect")
            btn_connect.get_style_context().add_class("btn-connect")
            btn_connect.set_valign(Gtk.Align.CENTER)
            btn_connect.connect("clicked", lambda b, n=net: self.connect_network(n))
            hbox.pack_end(btn_connect, False, False, 4)

        row.add(hbox)

        # Context Menu on Right Click
        row.connect("button-press-event", lambda w, e, n=net: self.on_row_button_press(w, e, n))

        return row

    def on_row_button_press(self, widget, event, net):
        if event.button == 3: # Right click
            menu = Gtk.Menu()

            if net["in_use"]:
                item_disc = Gtk.MenuItem(label="Disconnect")
                item_disc.connect("activate", lambda i: self.disconnect_network())
                menu.append(item_disc)
            else:
                item_conn = Gtk.MenuItem(label="Connect")
                item_conn.connect("activate", lambda i: self.connect_network(net))
                menu.append(item_conn)

            if net.get("security"):
                item_repass = Gtk.MenuItem(label="Enter / Change Password...")
                item_repass.connect("activate", lambda i: self.show_password_dialog(net["ssid"], net=net))
                menu.append(item_repass)

            item_ent = Gtk.MenuItem(label="Configure Enterprise (802.1X / EAP)...")
            item_ent.connect("activate", lambda i: self.show_enterprise_dialog(net))
            menu.append(item_ent)

            if net["ssid"] in self.saved_connections:
                item_forget = Gtk.MenuItem(label="Forget This Network")
                item_forget.connect("activate", lambda i: self.forget_network(net["ssid"]))
                menu.append(item_forget)

            menu.append(Gtk.SeparatorMenuItem())

            item_settings = Gtk.MenuItem(label="Advanced Network Settings...")
            item_settings.connect("activate", lambda i: subprocess.Popen(["nm-connection-editor"]))
            menu.append(item_settings)

            menu.show_all()
            menu.popup(None, None, None, None, event.button, event.time)
            return True
        return False

    def get_wifi_ifname(self):
        try:
            res = subprocess.run(["nmcli", "-t", "-f", "DEVICE,TYPE", "device"], capture_output=True, text=True)
            for line in res.stdout.splitlines():
                if line.endswith(":wifi"):
                    return line.split(":")[0]
        except Exception:
            pass
        return "wlan0"

    def is_enterprise_network(self, net):
        sec = (net.get("security") or "").upper()
        ssid = (net.get("ssid") or "").lower()
        if "802.1X" in sec or "EAP" in sec or "ENTERPRISE" in sec:
            return True
        if ssid == "eduroam":
            return True
        return False

    def connect_network(self, net):
        ssid = net["ssid"]
        is_saved = ssid in self.saved_connections
        is_secure = bool(net["security"])

        if is_saved or not is_secure:
            self._do_connect(ssid, None, net=net)
        elif self.is_enterprise_network(net):
            self.show_enterprise_dialog(net)
        else:
            self.show_password_dialog(ssid, net=net)

    def show_enterprise_dialog(self, net):
        ssid = net["ssid"]

        dialog = Gtk.Dialog(
            title=f"Connect to Enterprise Network ({ssid})",
            parent=self,
            flags=Gtk.DialogFlags.MODAL | Gtk.DialogFlags.DESTROY_WITH_PARENT
        )
        dialog.set_default_size(440, 380)
        dialog.set_border_width(12)

        content = dialog.get_content_area()
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        vbox.set_margin_top(4)
        vbox.set_margin_bottom(6)
        content.add(vbox)

        lbl_head = Gtk.Label()
        lbl_head.set_markup(
            f"<b>{GLib.markup_escape_text(ssid)}</b> (WPA-EAP / 802.1X Enterprise)\n"
            "<small><span alpha='75%'>Enter your network authentication method and user credentials:</span></small>"
        )
        lbl_head.set_halign(Gtk.Align.START)
        lbl_head.set_line_wrap(True)
        vbox.pack_start(lbl_head, False, False, 0)

        grid = Gtk.Grid()
        grid.set_column_spacing(10)
        grid.set_row_spacing(8)
        vbox.pack_start(grid, False, False, 4)

        # EAP Method
        lbl_eap = Gtk.Label(label="EAP Method:")
        lbl_eap.set_halign(Gtk.Align.START)
        combo_eap = Gtk.ComboBoxText()
        combo_eap.append("peap", "PEAP (Protected EAP)")
        combo_eap.append("ttls", "TTLS (Tunneled TLS)")
        combo_eap.append("pwd", "PWD")
        combo_eap.append("tls", "TLS")
        combo_eap.append("fast", "FAST")
        combo_eap.append("leap", "LEAP")
        combo_eap.set_active_id("peap")
        grid.attach(lbl_eap, 0, 0, 1, 1)
        grid.attach(combo_eap, 1, 0, 1, 1)

        # Phase 2 Auth
        lbl_p2 = Gtk.Label(label="Phase 2 Auth:")
        lbl_p2.set_halign(Gtk.Align.START)
        combo_p2 = Gtk.ComboBoxText()
        combo_p2.append("mschapv2", "MSCHAPv2")
        combo_p2.append("pap", "PAP")
        combo_p2.append("gtc", "GTC")
        combo_p2.append("mschap", "MSCHAP")
        combo_p2.append("chap", "CHAP")
        combo_p2.append("none", "None / Automatic")
        combo_p2.set_active_id("mschapv2")
        grid.attach(lbl_p2, 0, 1, 1, 1)
        grid.attach(combo_p2, 1, 1, 1, 1)

        # CA Certificate Mode
        lbl_ca = Gtk.Label(label="CA Certificate:")
        lbl_ca.set_halign(Gtk.Align.START)
        combo_ca = Gtk.ComboBoxText()
        combo_ca.append("none", "No Certificate Required (No validation)")
        combo_ca.append("system", "Use System CA Certificates")
        combo_ca.append("file", "Select Custom Certificate File (.crt/.pem)")
        combo_ca.set_active_id("none")
        grid.attach(lbl_ca, 0, 2, 1, 1)
        grid.attach(combo_ca, 1, 2, 1, 1)

        # Optional CA Cert File Chooser
        lbl_ca_file = Gtk.Label(label="Certificate File:")
        lbl_ca_file.set_halign(Gtk.Align.START)
        file_ca = Gtk.FileChooserButton(title="Select CA Certificate", action=Gtk.FileChooserAction.OPEN)
        grid.attach(lbl_ca_file, 0, 3, 1, 1)
        grid.attach(file_ca, 1, 3, 1, 1)

        def on_ca_mode_changed(combo):
            is_file = combo.get_active_id() == "file"
            lbl_ca_file.set_visible(is_file)
            file_ca.set_visible(is_file)

        combo_ca.connect("changed", on_ca_mode_changed)

        # Identity
        lbl_user = Gtk.Label(label="Username / Identity:")
        lbl_user.set_halign(Gtk.Align.START)
        entry_user = Gtk.Entry()
        entry_user.set_hexpand(True)
        entry_user.set_placeholder_text("e.g. user@institution.edu or username")
        grid.attach(lbl_user, 0, 4, 1, 1)
        grid.attach(entry_user, 1, 4, 1, 1)

        # Anonymous Identity
        lbl_anon = Gtk.Label(label="Anonymous Identity:")
        lbl_anon.set_halign(Gtk.Align.START)
        entry_anon = Gtk.Entry()
        entry_anon.set_hexpand(True)
        entry_anon.set_placeholder_text("Optional (can be left blank)")
        grid.attach(lbl_anon, 0, 5, 1, 1)
        grid.attach(entry_anon, 1, 5, 1, 1)

        # Domain Suffix Match (Optional)
        lbl_dom = Gtk.Label(label="Server Domain:")
        lbl_dom.set_halign(Gtk.Align.START)
        entry_dom = Gtk.Entry()
        entry_dom.set_hexpand(True)
        entry_dom.set_placeholder_text("Optional (e.g. institution.edu)")
        grid.attach(lbl_dom, 0, 6, 1, 1)
        grid.attach(entry_dom, 1, 6, 1, 1)

        # Password
        lbl_pass = Gtk.Label(label="Password:")
        lbl_pass.set_halign(Gtk.Align.START)
        entry_pass = Gtk.Entry()
        entry_pass.set_hexpand(True)
        entry_pass.set_visibility(False)
        entry_pass.set_activates_default(True)
        entry_pass.set_placeholder_text("Network password")
        grid.attach(lbl_pass, 0, 7, 1, 1)
        grid.attach(entry_pass, 1, 7, 1, 1)

        chk_show = Gtk.CheckButton(label="Show Password")
        chk_show.connect("toggled", lambda c: entry_pass.set_visibility(c.get_active()))
        vbox.pack_start(chk_show, False, False, 0)

        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        btn_ok = dialog.add_button("Connect", Gtk.ResponseType.OK)
        btn_ok.get_style_context().add_class("btn-connect")
        dialog.set_default_response(Gtk.ResponseType.OK)

        dialog.show_all()
        on_ca_mode_changed(combo_ca)
        self.is_showing_dialog = True
        try:
            response = dialog.run()
            identity = entry_user.get_text().strip()
            anon_id = entry_anon.get_text().strip()
            domain_match = entry_dom.get_text().strip()
            password = entry_pass.get_text()
            eap_method = combo_eap.get_active_id() or "peap"
            phase2_auth = combo_p2.get_active_id() or "mschapv2"
            ca_mode = combo_ca.get_active_id() or "none"
            ca_cert_path = file_ca.get_filename() if ca_mode == "file" else None
        finally:
            dialog.destroy()
            self.is_showing_dialog = False

        if response == Gtk.ResponseType.OK and identity and password:
            self._do_connect_enterprise(
                ssid, identity, password, eap_method, phase2_auth,
                anon_id, ca_mode, ca_cert_path, domain_match, net=net
            )

    def _do_connect_enterprise(
        self, ssid, identity, password, eap_method, phase2_auth,
        anon_id, ca_mode, ca_cert_path=None, domain_match="", net=None
    ):
        self.show_info(f"Connecting to enterprise network '{ssid}'...", Gtk.MessageType.INFO)
        self.spinner.start()

        def ent_thread():
            ifname = self.get_wifi_ifname()
            subprocess.run(["nmcli", "connection", "delete", "id", ssid], capture_output=True)
            cmd = [
                "nmcli", "connection", "add",
                "type", "wifi",
                "con-name", ssid,
                "ifname", ifname,
                "ssid", ssid,
                "wifi-sec.key-mgmt", "wpa-eap",
                "802-1x.eap", eap_method,
                "802-1x.identity", identity,
                "802-1x.password", password,
                "802-1x.password-flags", "0",
            ]
            if phase2_auth and phase2_auth != "none":
                cmd.extend(["802-1x.phase2-auth", phase2_auth])
            if anon_id:
                cmd.extend(["802-1x.anonymous-identity", anon_id])
            if domain_match:
                cmd.extend(["802-1x.domain-suffix-match", domain_match])
            if ca_mode == "system":
                cmd.extend(["802-1x.system-ca-certs", "yes"])
            elif ca_mode == "file" and ca_cert_path:
                cmd.extend(["802-1x.ca-cert", ca_cert_path])
            else:
                cmd.extend(["802-1x.system-ca-certs", "no"])

            res_add = subprocess.run(cmd, capture_output=True, text=True)
            if res_add.returncode != 0:
                GLib.idle_add(self._on_connect_finished, ssid, res_add.returncode, res_add.stdout, res_add.stderr, net, False)
                return

            res_up = subprocess.run(
                ["nmcli", "--wait", "20", "connection", "up", "id", ssid, "ifname", ifname],
                capture_output=True, text=True
            )
            if res_up.returncode != 0:
                # Clean up failed profile so it doesn't stay stuck as "Saved"
                subprocess.run(["nmcli", "connection", "delete", "id", ssid], capture_output=True)
            GLib.idle_add(self._on_connect_finished, ssid, res_up.returncode, res_up.stdout, res_up.stderr, net, False)

        threading.Thread(target=ent_thread, daemon=True).start()

    def show_password_dialog(self, ssid, net=None):
        dialog = Gtk.Dialog(
            title="Connect to Network",
            parent=self,
            flags=Gtk.DialogFlags.MODAL | Gtk.DialogFlags.DESTROY_WITH_PARENT
        )
        dialog.set_default_size(400, 170)
        dialog.set_border_width(12)

        content = dialog.get_content_area()
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        vbox.set_margin_top(6)
        vbox.set_margin_bottom(6)
        content.add(vbox)

        lbl = Gtk.Label()
        lbl.set_markup(f"Enter Wi-Fi password for <b>{GLib.markup_escape_text(ssid)}</b>:")
        lbl.set_halign(Gtk.Align.START)
        vbox.pack_start(lbl, False, False, 0)

        entry = Gtk.Entry()
        entry.set_visibility(False)
        entry.set_activates_default(True)
        vbox.pack_start(entry, False, False, 0)

        chk_show = Gtk.CheckButton(label="Show Password")
        chk_show.connect("toggled", lambda c: entry.set_visibility(c.get_active()))
        vbox.pack_start(chk_show, False, False, 0)

        # Button ID 42 switches directly to the 802.1X Enterprise dialog
        dialog.add_button("802.1X / Enterprise", 42)
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        btn_ok = dialog.add_button("Connect", Gtk.ResponseType.OK)
        btn_ok.get_style_context().add_class("btn-connect")
        dialog.set_default_response(Gtk.ResponseType.OK)

        dialog.show_all()
        self.is_showing_dialog = True
        try:
            response = dialog.run()
            password = entry.get_text()
        finally:
            dialog.destroy()
            self.is_showing_dialog = False

        if response == 42:
            self.show_enterprise_dialog(net or {"ssid": ssid, "security": "WPA2 802.1X"})
        elif response == Gtk.ResponseType.OK and password:
            self._do_connect(ssid, password, net=net)

    def _delete_existing_profiles(self, ssid):
        """Removes all saved NetworkManager profiles matching SSID or connection name."""
        subprocess.run(["nmcli", "connection", "delete", "id", ssid], capture_output=True)
        try:
            res = subprocess.run(
                ["nmcli", "-t", "-f", "UUID,NAME,TYPE", "connection", "show"],
                capture_output=True, text=True
            )
            for line in res.stdout.splitlines():
                parts = line.split(":")
                if len(parts) >= 3 and parts[2] == "802-11-wireless" and parts[1] == ssid:
                    subprocess.run(["nmcli", "connection", "delete", "uuid", parts[0]], capture_output=True)
        except Exception:
            pass

    def _do_connect(self, ssid, password, net=None):
        self.show_info(f"Connecting to '{ssid}'...", Gtk.MessageType.INFO)
        self.spinner.start()

        def connect_thread():
            ifname = self.get_wifi_ifname()
            used_saved_without_pass = False

            if password:
                # 1. Clean any stale profile first
                self._delete_existing_profiles(ssid)
                sec_str = (net.get("security", "") if net else "").upper()
                is_pure_wpa3 = ("WPA3" in sec_str and "WPA2" not in sec_str and "WPA1" not in sec_str)
                primary_mgmt = "sae" if is_pure_wpa3 else "wpa-psk"

                # 2. Create profile explicitly with psk-flags=0 (identical to nmtui so no secret agent is needed!)
                add_cmd = [
                    "nmcli", "connection", "add",
                    "type", "wifi",
                    "con-name", ssid,
                    "ifname", ifname,
                    "ssid", ssid,
                    "wifi-sec.key-mgmt", primary_mgmt,
                    "wifi-sec.psk", password,
                    "wifi-sec.psk-flags", "0",
                ]
                res_add = subprocess.run(add_cmd, capture_output=True, text=True)
                if res_add.returncode == 0:
                    res = subprocess.run(
                        ["nmcli", "--wait", "20", "connection", "up", "id", ssid, "ifname", ifname],
                        capture_output=True, text=True
                    )
                else:
                    res = res_add

                # 3. Fallback A: WPA2/WPA3 transitional mobile hotspots (PMF optional + alternate key-mgmt)
                if res.returncode != 0:
                    subprocess.run(["nmcli", "connection", "modify", "id", ssid, "wifi-sec.pmf", "1"], capture_output=True)
                    res = subprocess.run(
                        ["nmcli", "--wait", "20", "connection", "up", "id", ssid, "ifname", ifname],
                        capture_output=True, text=True
                    )

                if res.returncode != 0 and "WPA3" in sec_str:
                    alt_mgmt = "wpa-psk" if primary_mgmt == "sae" else "sae"
                    subprocess.run(
                        ["nmcli", "connection", "modify", "id", ssid, "wifi-sec.key-mgmt", alt_mgmt, "wifi-sec.pmf", "1"],
                        capture_output=True
                    )
                    res = subprocess.run(
                        ["nmcli", "--wait", "20", "connection", "up", "id", ssid, "ifname", ifname],
                        capture_output=True, text=True
                    )

                # 4. Fallback B: Direct nmcli device wifi connect
                if res.returncode != 0:
                    self._delete_existing_profiles(ssid)
                    res = subprocess.run(
                        ["nmcli", "--wait", "15", "device", "wifi", "connect", ssid, "password", password, "ifname", ifname],
                        capture_output=True, text=True
                    )

                # If all attempts failed, remove the broken profile so the network doesn't stay stuck as "Kayıtlı"
                if res.returncode != 0:
                    self._delete_existing_profiles(ssid)
            else:
                if ssid in self.saved_connections:
                    used_saved_without_pass = True
                    cmd = ["nmcli", "--wait", "15", "connection", "up", "id", ssid, "ifname", ifname]
                else:
                    cmd = ["nmcli", "--wait", "15", "device", "wifi", "connect", ssid, "ifname", ifname]
                res = subprocess.run(cmd, capture_output=True, text=True)

            GLib.idle_add(
                self._on_connect_finished,
                ssid, res.returncode, res.stdout, res.stderr, net, used_saved_without_pass
            )

        threading.Thread(target=connect_thread, daemon=True).start()

    def _on_connect_finished(self, ssid, returncode, stdout, stderr, net=None, used_saved_without_pass=False):
        self.spinner.stop()
        if returncode == 0:
            self.show_info(f"Successfully connected to '{ssid}'!", Gtk.MessageType.INFO)
            self.start_scan(rescan=False)
        else:
            err_msg = stderr.strip() or stdout.strip() or "Connection error occurred."
            # If a previously saved profile failed due to missing/changed password, prompt the user immediately!
            if used_saved_without_pass and net and net.get("security"):
                self.show_info(f"Authentication required for '{ssid}'.", Gtk.MessageType.WARNING)
                if self.is_enterprise_network(net):
                    self.show_enterprise_dialog(net)
                else:
                    self.show_password_dialog(ssid, net=net)
                return

            if "Secrets were required" in err_msg or "authentication" in err_msg.lower() or "no-secrets" in err_msg.lower():
                err_msg = "Incorrect password or authentication failed."
            self.show_info(f"Connection Error: {err_msg}", Gtk.MessageType.ERROR)
            self.start_scan(rescan=False)

    def disconnect_network(self):
        self.show_info("Disconnecting...", Gtk.MessageType.INFO)
        def disc_thread():
            subprocess.run(["nmcli", "device", "disconnect", self.get_wifi_ifname()], capture_output=True)
            GLib.idle_add(lambda: self.start_scan(rescan=False))
        threading.Thread(target=disc_thread, daemon=True).start()

    def forget_network(self, ssid):
        def forget_thread():
            subprocess.run(["nmcli", "connection", "delete", "id", ssid], capture_output=True)
            GLib.idle_add(lambda: self.start_scan(rescan=False))
        threading.Thread(target=forget_thread, daemon=True).start()

    def on_search_changed(self, entry):
        self.listbox.invalidate_filter()

    def filter_network_row(self, row):
        query = self.search_entry.get_text().strip().lower()
        if not query:
            return True
        return query in getattr(row, "ssid", "").lower()


class WifiManagerApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="org.antigravity.wifimanager",
            flags=Gio.ApplicationFlags.NON_UNIQUE
        )
        self.window = None

    def do_activate(self):
        if not self.window:
            css_provider = Gtk.CssProvider()
            css_provider.load_from_data(SmartFocus.get_themed_css(CSS_STYLE))
            screen = Gdk.Screen.get_default()
            Gtk.StyleContext.add_provider_for_screen(
                screen,
                css_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

            self.window = WifiManagerWindow(self)
            self.window.connect('destroy', lambda w: setattr(self, 'window', None))
            self.window.present()
        else:
            self.window.close()
            self.window = None


if __name__ == "__main__":
    app = WifiManagerApp()
    sys.exit(app.run(sys.argv))
