#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

KVER="$(uname -r)"
SRC_DIR="/home/bren/.cache/damx-build/Linuwu-Sense"
MOD_DST_DIR="/usr/lib/modules/${KVER}/kernel/drivers/platform/x86"

echo ">>> [1/4] Linuwu-Sense sürücüsü ${KVER} çekirdeği için kontrol ediliyor..."
if [ ! -f "${SRC_DIR}/src/linuwu_sense.ko" ]; then
    cd "${SRC_DIR}"
    make -C "/lib/modules/${KVER}/build" M="$(pwd)" LLVM=1 modules
fi

echo ">>> [2/4] linuwu_sense.ko modülü yükleniyor..."
install -Dm644 "${SRC_DIR}/src/linuwu_sense.ko" "${MOD_DST_DIR}/linuwu_sense.ko"
depmod -a "${KVER}"
modprobe -r acer_wmi 2>/dev/null || true
modprobe linuwu_sense

echo ">>> [3/4] Gelecekteki pacman -Syu çekirdek güncellemeleri için DKMS kaydediliyor..."
DKMS_DIR="/usr/src/linuwu-sense-1.0.0"
rm -rf "${DKMS_DIR}"
mkdir -p "${DKMS_DIR}/src"
cp -f "${SRC_DIR}/Makefile" "${DKMS_DIR}/Makefile"
cp -f "${SRC_DIR}/src/linuwu_sense.c" "${DKMS_DIR}/src/linuwu_sense.c"

cat > "${DKMS_DIR}/dkms.conf" << 'EOF'
PACKAGE_NAME="linuwu-sense"
PACKAGE_VERSION="1.0.0"
BUILT_MODULE_NAME[0]="linuwu_sense"
BUILT_MODULE_LOCATION[0]="src"
DEST_MODULE_LOCATION[0]="/kernel/drivers/platform/x86"
MAKE[0]="make LLVM=1 -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build modules"
CLEAN="make -C ${kernel_source_dir} M=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build clean"
AUTOINSTALL="yes"
EOF

dkms remove -m linuwu-sense -v 1.0.0 --all 2>/dev/null || true
dkms add -m linuwu-sense -v 1.0.0 2>/dev/null || true

echo ">>> [4/4] damx-daemon servisi yeniden başlatılıyor..."
rm -f /tmp/damx_restart_attempts
systemctl restart damx-daemon.service
echo ">>> Başarılı! DAMX ve Linuwu-Sense aktif."
