#!/usr/bin/env python3
import os
import sys
import json
import math
import shutil
import subprocess
from pathlib import Path
from urllib.parse import unquote, urlparse

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GtkLayerShell', '0.1')
from gi.repository import Gtk, Gdk, Gio, GLib, Pango, PangoCairo, GdkPixbuf, GtkLayerShell
import cairo

DESKTOP_DIR = Path.home() / "Masaüstü"
TRASH_FILES_DIR = Path.home() / ".local/share/Trash/files"
TRASH_INFO_DIR = Path.home() / ".local/share/Trash/info"
POSITIONS_FILE = Path.home() / ".config/desktop-icons-positions.json"

CELL_W = 104
CELL_H = 112
MARGIN_TOP = 14
MARGIN_LEFT = 20
MARGIN_BOTTOM = 20
MARGIN_RIGHT = 20
ICON_SIZE = 48

FOLDER_COLORS = [
    ("Varsayılan", "folder", "#cba6f7"),
    ("Mavi", "folder-blue", "#89b4fa"),
    ("Camgöbeği", "folder-cyan", "#89dceb"),
    ("Yeşil", "folder-green", "#a6e3a1"),
    ("Sarı", "folder-yellow", "#f9e2af"),
    ("Turuncu", "folder-orange", "#fab387"),
    ("Kırmızı", "folder-red", "#f38ba8"),
    ("Pembe", "folder-magenta", "#f5c2e7"),
    ("Mor", "folder-violet", "#b4befe"),
    ("Kahverengi", "folder-brown", "#eba0ac"),
    ("Gri", "folder-grey", "#9399b2"),
    ("Siyah", "folder-black", "#45475a"),
]

CSS = b"""
window.desktop-window {
    background-color: transparent;
}
"""

IMAGE_EXTS = {'.png', '.jpg', '.jpeg', '.webp', '.gif', '.bmp', '.svg'}


class DesktopItem:
    def __init__(self, path: Path, col: int, row: int, init_pos=None, custom_color_icon=None):
        self.path = path
        self.name = path.name
        self.col = col
        self.row = row
        self.target_x = float(MARGIN_LEFT + col * CELL_W)
        self.target_y = float(MARGIN_TOP + row * CELL_H)
        if init_pos:
            self.x, self.y = float(init_pos[0]), float(init_pos[1])
        else:
            self.x, self.y = self.target_x, self.target_y
        self.scale = 1.0
        self.target_scale = 1.0
        self.display_name = self.name
        self.pixbuf = None
        self.is_desktop_file = self.path.suffix == '.desktop'
        self.exec_cmd = None
        self.custom_color_icon = custom_color_icon
        self.load_metadata()

    def update_target_pos(self, snap_immediately=False):
        self.target_x = float(MARGIN_LEFT + self.col * CELL_W)
        self.target_y = float(MARGIN_TOP + self.row * CELL_H)
        if snap_immediately:
            self.x = self.target_x
            self.y = self.target_y

    def get_folder_custom_icon(self):
        if self.custom_color_icon:
            return self.custom_color_icon
        dir_cfg = self.path / ".directory"
        if dir_cfg.is_file():
            try:
                kf = GLib.KeyFile()
                kf.load_from_file(str(dir_cfg), GLib.KeyFileFlags.NONE)
                if kf.has_key("Desktop Entry", "Icon"):
                    return kf.get_string("Desktop Entry", "Icon")
            except Exception:
                pass
        return None

    def load_metadata(self):
        self.pixbuf = None
        icon_theme = Gtk.IconTheme.get_default()

        if self.path.is_dir():
            folder_icon = self.get_folder_custom_icon()
            if folder_icon:
                self.pixbuf = self._load_theme_icon(icon_theme, [folder_icon, "folder"])

        if self.is_desktop_file and self.path.is_file():
            try:
                kf = GLib.KeyFile()
                kf.load_from_file(str(self.path), GLib.KeyFileFlags.NONE)
                if kf.has_key("Desktop Entry", "Name"):
                    self.display_name = kf.get_locale_string("Desktop Entry", "Name", None)
                if kf.has_key("Desktop Entry", "Exec"):
                    self.exec_cmd = kf.get_string("Desktop Entry", "Exec")
                if kf.has_key("Desktop Entry", "Icon"):
                    icon_name = kf.get_string("Desktop Entry", "Icon")
                    if os.path.isabs(icon_name) and os.path.exists(icon_name):
                        self.pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(icon_name, ICON_SIZE, ICON_SIZE, True)
                    else:
                        self.pixbuf = self._load_theme_icon(icon_theme, [icon_name, "application-x-executable"])
            except Exception:
                pass

        if self.pixbuf is None and self.path.is_file() and self.path.suffix.lower() in IMAGE_EXTS:
            try:
                self.pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(self.path), ICON_SIZE, ICON_SIZE, True)
            except Exception:
                pass

        if self.pixbuf is None:
            try:
                gfile = Gio.File.new_for_path(str(self.path))
                info = gfile.query_info("standard::icon", Gio.FileQueryInfoFlags.NONE, None)
                gicon = info.get_icon()
                if gicon:
                    icon_info = icon_theme.lookup_by_gicon(gicon, ICON_SIZE, Gtk.IconLookupFlags.FORCE_SIZE)
                    if icon_info:
                        self.pixbuf = icon_info.load_icon()
            except Exception:
                pass

        if self.pixbuf is None:
            fallback = ["folder", "inode-directory"] if self.path.is_dir() else ["text-x-generic", "application-octet-stream"]
            self.pixbuf = self._load_theme_icon(icon_theme, fallback)

    def _load_theme_icon(self, theme, names):
        for name in names:
            try:
                if theme.has_icon(name):
                    return theme.load_icon(name, ICON_SIZE, Gtk.IconLookupFlags.FORCE_SIZE)
            except Exception:
                continue
        return None


class DesktopManager(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        DESKTOP_DIR.mkdir(parents=True, exist_ok=True)
        TRASH_FILES_DIR.mkdir(parents=True, exist_ok=True)
        TRASH_INFO_DIR.mkdir(parents=True, exist_ok=True)

        self.get_style_context().add_class("desktop-window")
        self.set_app_paintable(True)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        # Configure Wayland Layer Shell:
        # Respect exclusive zones (set_exclusive_zone(0)) so we NEVER cover Waybar!
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "desktop-icons")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.BOTTOM)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_exclusive_zone(self, 0)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)

        # Preload mini 20x20 folder color icons for KDE-style context menu palette
        self.mini_folder_pixbufs = {}
        icon_theme = Gtk.IconTheme.get_default()
        for _label, icon_name, _hex in FOLDER_COLORS:
            try:
                if icon_theme.has_icon(icon_name):
                    self.mini_folder_pixbufs[icon_name] = icon_theme.load_icon(icon_name, 20, Gtk.IconLookupFlags.FORCE_SIZE)
            except Exception:
                pass

        self.items = []
        self.positions, self.folder_colors = self.load_state()
        self.selected_paths = set()
        self.hovered_item = None

        # Drag state
        self.dragging_items = []
        self.primary_drag_item = None
        self.drag_start_x = 0.0
        self.drag_start_y = 0.0
        self.drag_curr_x = 0.0
        self.drag_curr_y = 0.0
        self.drag_offsets = {}
        self.is_dragging_icon = False
        self.drop_target_folder = None
        self.anim_timer_id = None

        # Rubberband selection state
        self.rubberband_active = False
        self.rb_start_x = 0.0
        self.rb_start_y = 0.0
        self.rb_curr_x = 0.0
        self.rb_curr_y = 0.0

        # In-canvas animated context menu state (with KDE mini folder icon grid)
        self.ctx_active = False
        self.ctx_closing = False
        self.ctx_progress = 0.0
        self.ctx_x = 0.0
        self.ctx_y = 0.0
        self.ctx_w = 216.0
        self.ctx_h = 100.0
        self.ctx_folder_item = None
        self.ctx_entries = []  # list of dicts: {"type": "item"|"sep", "label": str, "cb": callable, "enabled": bool, "y": float, "h": float}
        self.ctx_hovered_idx = -1
        self.ctx_hovered_color_idx = -1
        self.ctx_color_rects = []  # list of (rx, ry, rw, rh, icon_name, label)

        # Animated in-canvas macOS-style modal overlay state
        self.modal_active = False
        self.modal_closing = False
        self.modal_confirm_on_close = False
        self.modal_progress = 0.0
        self.modal_title = ""
        self.modal_subtitle = ""
        self.modal_text = ""
        self.modal_cursor = 0
        self.modal_select_all = False
        self.modal_callback = None
        self.modal_hover_btn = None

        self.clipboard_paths = []
        self.clipboard_is_cut = False

        self.darea = Gtk.DrawingArea()
        self.darea.set_can_focus(True)
        self.darea.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.KEY_PRESS_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
        )

        targets = [Gtk.TargetEntry.new("text/uri-list", 0, 0)]
        self.darea.drag_dest_set(Gtk.DestDefaults.ALL, targets, Gdk.DragAction.COPY | Gdk.DragAction.MOVE)
        self.darea.connect("drag-data-received", self.on_drag_data_received)

        self.darea.connect("draw", self.on_draw)
        self.darea.connect("button-press-event", self.on_button_press)
        self.darea.connect("button-release-event", self.on_button_release)
        self.darea.connect("motion-notify-event", self.on_motion)
        self.darea.connect("key-press-event", self.on_key_press)
        self.add(self.darea)

        self.gfile_dir = Gio.File.new_for_path(str(DESKTOP_DIR))
        self.monitor = self.gfile_dir.monitor_directory(Gio.FileMonitorFlags.NONE, None)
        self.monitor.connect("changed", self.on_directory_changed)

        self.reload_items()
        self.show_all()

    def ensure_animation_loop(self):
        if self.anim_timer_id is None:
            self.anim_timer_id = GLib.timeout_add(8, self.on_animation_tick)

    def on_animation_tick(self):
        needs_more = False
        lerp_factor = 0.28

        for item in self.items:
            dx = item.target_x - item.x
            dy = item.target_y - item.y
            ds = item.target_scale - item.scale

            if abs(dx) > 0.4 or abs(dy) > 0.4:
                item.x += dx * lerp_factor
                item.y += dy * lerp_factor
                needs_more = True
            else:
                item.x = item.target_x
                item.y = item.target_y

            if abs(ds) > 0.005:
                item.scale += ds * 0.32
                needs_more = True
            else:
                item.scale = item.target_scale

        if self.ctx_active:
            target_cp = 0.0 if self.ctx_closing else 1.0
            dcp = target_cp - self.ctx_progress
            if abs(dcp) > 0.02:
                self.ctx_progress += dcp * 0.36
                needs_more = True
            else:
                self.ctx_progress = target_cp
                if self.ctx_closing:
                    self.ctx_active = False
                    self.ctx_closing = False

        if self.modal_active:
            target_p = 0.0 if self.modal_closing else 1.0
            dp = target_p - self.modal_progress
            if abs(dp) > 0.015:
                self.modal_progress += dp * 0.30
                needs_more = True
            else:
                self.modal_progress = target_p
                if self.modal_closing:
                    self._finalize_modal_close()

        self.darea.queue_draw()
        if not needs_more:
            self.anim_timer_id = None
            return False
        return True

    def load_state(self):
        if POSITIONS_FILE.exists():
            try:
                raw = json.loads(POSITIONS_FILE.read_text(encoding="utf-8"))
                if isinstance(raw, dict) and "positions" in raw:
                    return raw.get("positions", {}), raw.get("colors", {})
                elif isinstance(raw, dict):
                    return raw, {}
            except Exception:
                return {}, {}
        return {}, {}

    def save_positions(self):
        try:
            pos_data = {item.name: [item.col, item.row] for item in self.items}
            full_data = {
                "positions": pos_data,
                "colors": self.folder_colors,
            }
            POSITIONS_FILE.parent.mkdir(parents=True, exist_ok=True)
            POSITIONS_FILE.write_text(json.dumps(full_data, ensure_ascii=False, indent=2), encoding="utf-8")
            self.positions = pos_data
        except Exception:
            pass

    def set_folder_color(self, item: DesktopItem, icon_name: str):
        if icon_name == "folder":
            self.folder_colors.pop(item.name, None)
            item.custom_color_icon = None
            dir_file = item.path / ".directory"
            if dir_file.exists():
                try:
                    dir_file.unlink()
                except Exception:
                    pass
        else:
            self.folder_colors[item.name] = icon_name
            item.custom_color_icon = icon_name
            dir_file = item.path / ".directory"
            try:
                dir_file.write_text(f"[Desktop Entry]\nIcon={icon_name}\n", encoding="utf-8")
            except Exception:
                pass

        item.load_metadata()
        self.save_positions()
        self.darea.queue_draw()

    def get_max_rows(self):
        alloc = self.get_allocation()
        h = alloc.height if alloc.height > 200 else 824
        usable_h = max(CELL_H, h - MARGIN_TOP - MARGIN_BOTTOM)
        return max(1, usable_h // CELL_H)

    def get_max_cols(self):
        alloc = self.get_allocation()
        w = alloc.width if alloc.width > 200 else 1536
        usable_w = max(CELL_W, w - MARGIN_LEFT - MARGIN_RIGHT)
        return max(1, usable_w // CELL_W)

    def reload_items(self):
        old_coords = {it.name: (it.x, it.y) for it in self.items}
        try:
            entries = sorted(
                [p for p in DESKTOP_DIR.iterdir() if not p.name.startswith('.')],
                key=lambda p: (not p.is_dir(), p.name.lower())
            )
        except Exception:
            entries = []

        occupied = set()
        new_items = []
        max_rows = self.get_max_rows()

        unplaced = []
        for p in entries:
            if p.name in self.positions:
                col, row = self.positions[p.name]
                if (col, row) not in occupied and col >= 0 and row >= 0:
                    occupied.add((col, row))
                    new_items.append(DesktopItem(
                        p, col, row,
                        init_pos=old_coords.get(p.name),
                        custom_color_icon=self.folder_colors.get(p.name)
                    ))
                else:
                    unplaced.append(p)
            else:
                unplaced.append(p)

        for p in unplaced:
            col, row = 0, 0
            while (col, row) in occupied:
                row += 1
                if row >= max_rows:
                    row = 0
                    col += 1
            occupied.add((col, row))
            new_items.append(DesktopItem(
                p, col, row,
                init_pos=old_coords.get(p.name),
                custom_color_icon=self.folder_colors.get(p.name)
            ))

        self.items = new_items
        self.save_positions()
        self.ensure_animation_loop()

    def on_directory_changed(self, monitor, file, other_file, event_type):
        if file and file.get_basename().startswith('.'):
            return
        if event_type in (
            Gio.FileMonitorEvent.CREATED,
            Gio.FileMonitorEvent.DELETED,
            Gio.FileMonitorEvent.MOVED_IN,
            Gio.FileMonitorEvent.MOVED_OUT,
            Gio.FileMonitorEvent.RENAMED,
            Gio.FileMonitorEvent.CHANGES_DONE_HINT,
        ):
            GLib.idle_add(self.reload_items)

    def item_at(self, x, y, exclude_set=None):
        for item in reversed(self.items):
            if exclude_set and item in exclude_set:
                continue
            if item.x <= x <= item.x + CELL_W and item.y <= y <= item.y + CELL_H:
                return item
        return None

    def on_draw(self, widget, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        if self.is_dragging_icon and self.primary_drag_item and not self.drop_target_folder:
            gx = self.primary_drag_item.x + CELL_W / 2
            gy = self.primary_drag_item.y + CELL_H / 2
            col = max(0, min(self.get_max_cols() - 1, int((gx - MARGIN_LEFT) // CELL_W)))
            row = max(0, min(self.get_max_rows() - 1, int((gy - MARGIN_TOP) // CELL_H)))
            sx = MARGIN_LEFT + col * CELL_W + 4
            sy = MARGIN_TOP + row * CELL_H + 4
            self._rounded_rect(cr, sx, sy, CELL_W - 8, CELL_H - 8, 12)
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.08)
            cr.fill_preserve()
            cr.set_source_rgba(0.796, 0.651, 0.969, 0.35)
            cr.set_line_width(1.2)
            cr.stroke()

        normal_items = [it for it in self.items if it not in self.dragging_items]
        for item in normal_items:
            is_selected = str(item.path) in self.selected_paths
            is_hovered = (self.hovered_item == item) or (self.drop_target_folder == item)
            self.draw_item(cr, item, is_selected, is_hovered, is_dragged=False)

        for item in self.dragging_items:
            self.draw_item(cr, item, True, False, is_dragged=self.is_dragging_icon)

        if self.rubberband_active:
            rx = min(self.rb_start_x, self.rb_curr_x)
            ry = min(self.rb_start_y, self.rb_curr_y)
            rw = abs(self.rb_curr_x - self.rb_start_x)
            rh = abs(self.rb_curr_y - self.rb_start_y)
            self._rounded_rect(cr, rx, ry, rw, rh, 6)
            cr.set_source_rgba(0.796, 0.651, 0.969, 0.20)
            cr.fill_preserve()
            cr.set_source_rgba(0.796, 0.651, 0.969, 0.80)
            cr.set_line_width(1.2)
            cr.stroke()

        if self.ctx_active:
            self.draw_context_menu(cr)

        if self.modal_active:
            self.draw_modal(cr)

    def draw_item(self, cr, item: DesktopItem, is_selected: bool, is_hovered: bool, is_dragged: bool):
        cr.save()
        cx = item.x + CELL_W / 2.0
        cy = item.y + CELL_H / 2.0
        if abs(item.scale - 1.0) > 0.001:
            cr.translate(cx, cy)
            cr.scale(item.scale, item.scale)
            cr.translate(-cx, -cy)

        pad = 4
        bx, by = item.x + pad, item.y + pad
        bw, bh = CELL_W - 2 * pad, CELL_H - 2 * pad
        radius = 11

        if self.drop_target_folder == item:
            self._rounded_rect(cr, bx - 2, by - 2, bw + 4, bh + 4, radius + 2)
            cr.set_source_rgba(0.796, 0.651, 0.969, 0.42)
            cr.fill_preserve()
            cr.set_source_rgba(0.796, 0.651, 0.969, 0.95)
            cr.set_line_width(2.0)
            cr.stroke()
        elif is_selected or is_hovered:
            self._rounded_rect(cr, bx, by, bw, bh, radius)
            if is_selected:
                cr.set_source_rgba(0.796, 0.651, 0.969, 0.26 if not is_dragged else 0.34)
                cr.fill_preserve()
                cr.set_source_rgba(0.796, 0.651, 0.969, 0.80)
                cr.set_line_width(1.2)
                cr.stroke()
            else:
                cr.set_source_rgba(1.0, 1.0, 1.0, 0.11)
                cr.fill()

        if item.pixbuf:
            ix = item.x + (CELL_W - item.pixbuf.get_width()) / 2
            iy = item.y + 10
            Gdk.cairo_set_source_pixbuf(cr, item.pixbuf, ix, iy)
            cr.paint_with_alpha(0.92 if is_dragged else 1.0)

        layout = self.darea.create_pango_layout(item.display_name)
        font_desc = Pango.FontDescription("JetBrainsMono Nerd Font Medium 9.5")
        layout.set_font_description(font_desc)
        layout.set_width((CELL_W - 12) * Pango.SCALE)
        layout.set_alignment(Pango.Alignment.CENTER)
        layout.set_wrap(Pango.WrapMode.WORD_CHAR)
        layout.set_ellipsize(Pango.EllipsizeMode.END)
        layout.set_height(-2)

        tx = item.x + 6
        ty = item.y + 14 + ICON_SIZE

        cr.set_source_rgba(0, 0, 0, 0.88)
        cr.move_to(tx + 1, ty + 1)
        PangoCairo.show_layout(cr, layout)

        cr.set_source_rgba(0.95, 0.96, 0.98, 1.0)
        cr.move_to(tx, ty)
        PangoCairo.show_layout(cr, layout)
        cr.restore()

    def open_context_menu(self, x: float, y: float, entries: list, folder_item=None):
        alloc = self.get_allocation()
        sw = alloc.width if alloc.width > 200 else 1536
        sh = alloc.height if alloc.height > 200 else 824

        menu_w = 206.0
        cur_y = 6.0

        # If this is a folder context menu, reserve top space for the KDE-style mini folder icon palette!
        self.ctx_folder_item = folder_item
        self.ctx_color_rects = []
        if folder_item is not None:
            # 2 rows of 6 mini folder icons (20x20 each in 28x26 slots)
            cols = 6
            slot_w = 30.0
            slot_h = 26.0
            start_x = (menu_w - cols * slot_w) / 2.0
            cur_y += 4.0
            for idx, (label_text, icon_name, hex_col) in enumerate(FOLDER_COLORS):
                r = idx // cols
                c = idx % cols
                rx = start_x + c * slot_w
                ry = cur_y + r * slot_h
                self.ctx_color_rects.append((rx, ry, slot_w, slot_h, icon_name, label_text, hex_col))
            cur_y += 2 * slot_h + 6.0
            entries = [{"type": "sep"}] + entries

        laid_out = []
        for e in entries:
            if e.get("type") == "sep":
                laid_out.append({"type": "sep", "y": cur_y, "h": 9.0})
                cur_y += 9.0
            else:
                laid_out.append({
                    "type": "item",
                    "label": e["label"],
                    "cb": e["cb"],
                    "enabled": e.get("enabled", True),
                    "y": cur_y,
                    "h": 26.0,
                })
                cur_y += 26.0
        cur_y += 6.0

        menu_h = cur_y
        if x + menu_w > sw - 8:
            x = sw - menu_w - 8
        if y + menu_h > sh - 8:
            y = sh - menu_h - 8

        self.ctx_x = max(8.0, x)
        self.ctx_y = max(8.0, y)
        self.ctx_w = menu_w
        self.ctx_h = menu_h
        self.ctx_entries = laid_out
        self.ctx_hovered_idx = -1
        self.ctx_hovered_color_idx = -1
        self.ctx_active = True
        self.ctx_closing = False
        self.ctx_progress = 0.0
        self.ensure_animation_loop()

    def close_context_menu(self):
        if not self.ctx_active or self.ctx_closing:
            return
        self.ctx_closing = True
        self.ensure_animation_loop()

    def draw_context_menu(self, cr):
        p = max(0.0, min(1.0, self.ctx_progress))
        scale = 0.92 + 0.08 * p

        mx, my, mw, mh = self.ctx_x, self.ctx_y, self.ctx_w, self.ctx_h
        cr.save()
        cr.translate(mx, my)
        cr.scale(scale, scale)
        cr.translate(-mx, -my)

        # Drop shadow
        self._rounded_rect(cr, mx - 2, my + 3, mw + 4, mh + 4, 12)
        cr.set_source_rgba(0, 0, 0, 0.38 * p)
        cr.fill()

        # Menu background
        self._rounded_rect(cr, mx, my, mw, mh, 10)
        cr.set_source_rgba(0.094, 0.094, 0.145, 0.95 * p)  # #181825
        cr.fill_preserve()
        cr.set_source_rgba(0.796, 0.651, 0.969, 0.28 * p)
        cr.set_line_width(1.1)
        cr.stroke()

        # Draw KDE Plasma style mini folder icon grid if folder item
        if self.ctx_folder_item is not None:
            current_icon = self.ctx_folder_item.get_folder_custom_icon() or "folder"
            for idx, (rx, ry, rw, rh, icon_name, _label, _hex) in enumerate(self.ctx_color_rects):
                ax, ay = mx + rx, my + ry
                is_current = (current_icon == icon_name)
                is_hov = (self.ctx_hovered_color_idx == idx)

                if is_current or is_hov:
                    self._rounded_rect(cr, ax + 2, ay + 1, rw - 4, rh - 2, 6)
                    if is_hov:
                        cr.set_source_rgba(0.796, 0.651, 0.969, 0.32 * p)
                    else:
                        cr.set_source_rgba(1.0, 1.0, 1.0, 0.12 * p)
                    cr.fill_preserve()
                    if is_current:
                        cr.set_source_rgba(0.796, 0.651, 0.969, 0.85 * p)
                        cr.set_line_width(1.2)
                        cr.stroke()
                    else:
                        cr.new_path()

                pb = self.mini_folder_pixbufs.get(icon_name)
                if pb:
                    ix = ax + (rw - pb.get_width()) / 2.0
                    iy = ay + (rh - pb.get_height()) / 2.0
                    Gdk.cairo_set_source_pixbuf(cr, pb, ix, iy)
                    cr.paint_with_alpha(p)

        # Draw menu items
        for idx, entry in enumerate(self.ctx_entries):
            ey = my + entry["y"]
            eh = entry["h"]
            if entry["type"] == "sep":
                cr.set_source_rgba(0.345, 0.357, 0.439, 0.35 * p)
                cr.set_line_width(1.0)
                cr.move_to(mx + 10, ey + eh / 2.0)
                cr.line_to(mx + mw - 10, ey + eh / 2.0)
                cr.stroke()
            else:
                enabled = entry["enabled"]
                is_hov = (idx == self.ctx_hovered_idx) and enabled
                if is_hov:
                    self._rounded_rect(cr, mx + 5, ey + 1, mw - 10, eh - 2, 6)
                    cr.set_source_rgba(0.796, 0.651, 0.969, p)
                    cr.fill()

                lbl = self.darea.create_pango_layout(entry["label"])
                lbl.set_font_description(Pango.FontDescription("JetBrainsMono Nerd Font 9.5"))
                _, lrect = lbl.get_pixel_extents()
                if not enabled:
                    cr.set_source_rgba(0.345, 0.357, 0.439, p)
                elif is_hov:
                    cr.set_source_rgba(0.067, 0.067, 0.106, p)
                else:
                    cr.set_source_rgba(0.804, 0.839, 0.957, p)
                cr.move_to(mx + 13, ey + (eh - lrect.height) / 2.0)
                PangoCairo.show_layout(cr, lbl)

        cr.restore()

    def get_modal_geometry(self):
        alloc = self.get_allocation()
        sw = alloc.width if alloc.width > 200 else 1536
        sh = alloc.height if alloc.height > 200 else 824
        mw, mh = 340, 168
        mx = (sw - mw) / 2.0
        my = (sh - mh) / 2.0
        return mx, my, mw, mh

    def draw_modal(self, cr):
        alloc = self.get_allocation()
        sw = alloc.width if alloc.width > 200 else 1536
        sh = alloc.height if alloc.height > 200 else 824

        p = max(0.0, min(1.0, self.modal_progress))
        scale = 0.86 + 0.14 * p
        y_offset = (1.0 - p) * 14.0

        cr.set_source_rgba(0.06, 0.06, 0.10, 0.42 * p)
        cr.rectangle(0, 0, sw, sh)
        cr.fill()

        mx, my, mw, mh = self.get_modal_geometry()
        cx = mx + mw / 2.0
        cy = my + mh / 2.0

        cr.save()
        cr.translate(cx, cy + y_offset)
        cr.scale(scale, scale)
        cr.translate(-cx, -cy)

        self._rounded_rect(cr, mx - 3, my + 5, mw + 6, mh + 6, 16)
        cr.set_source_rgba(0, 0, 0, 0.42 * p)
        cr.fill()

        self._rounded_rect(cr, mx, my, mw, mh, 14)
        cr.set_source_rgba(0.118, 0.118, 0.180, 0.96 * p)
        cr.fill_preserve()
        cr.set_source_rgba(0.796, 0.651, 0.969, 0.65 * p)
        cr.set_line_width(1.4)
        cr.stroke()

        title_layout = self.darea.create_pango_layout(self.modal_title)
        title_layout.set_font_description(Pango.FontDescription("JetBrainsMono Nerd Font Bold 11"))
        cr.set_source_rgba(0.804, 0.839, 0.957, p)
        cr.move_to(mx + 20, my + 18)
        PangoCairo.show_layout(cr, title_layout)

        sub_layout = self.darea.create_pango_layout(self.modal_subtitle)
        sub_layout.set_font_description(Pango.FontDescription("JetBrainsMono Nerd Font 9"))
        cr.set_source_rgba(0.651, 0.678, 0.784, p)
        cr.move_to(mx + 20, my + 42)
        PangoCairo.show_layout(cr, sub_layout)

        ex, ey, ew, eh = mx + 20, my + 68, mw - 40, 36
        self._rounded_rect(cr, ex, ey, ew, eh, 8)
        cr.set_source_rgba(0.192, 0.196, 0.267, p)
        cr.fill_preserve()
        cr.set_source_rgba(0.796, 0.651, 0.969, 0.85 * p)
        cr.set_line_width(1.2)
        cr.stroke()

        txt_layout = self.darea.create_pango_layout(self.modal_text)
        txt_layout.set_font_description(Pango.FontDescription("JetBrainsMono Nerd Font 10"))
        _, logical_rect = txt_layout.get_pixel_extents()

        if self.modal_select_all and self.modal_text:
            self._rounded_rect(cr, ex + 9, ey + 7, max(8, logical_rect.width + 4), eh - 14, 4)
            cr.set_source_rgba(0.796, 0.651, 0.969, 0.35 * p)
            cr.fill()

        cr.set_source_rgba(0.804, 0.839, 0.957, p)
        cr.move_to(ex + 11, ey + 9)
        PangoCairo.show_layout(cr, txt_layout)

        if not self.modal_select_all:
            sub_str = self.modal_text[:self.modal_cursor]
            c_layout = self.darea.create_pango_layout(sub_str)
            c_layout.set_font_description(Pango.FontDescription("JetBrainsMono Nerd Font 10"))
            _, c_rect = c_layout.get_pixel_extents()
            cx_pos = ex + 11 + c_rect.width
            cr.set_source_rgba(0.796, 0.651, 0.969, p)
            cr.set_line_width(1.5)
            cr.move_to(cx_pos, ey + 8)
            cr.line_to(cx_pos, ey + eh - 8)
            cr.stroke()

        bw, bh = 88, 30
        by = my + mh - 44
        cancel_x = mx + mw - 20 - bw * 2 - 8
        ok_x = mx + mw - 20 - bw

        self._rounded_rect(cr, cancel_x, by, bw, bh, 7)
        if self.modal_hover_btn == "cancel":
            cr.set_source_rgba(0.271, 0.278, 0.353, p)
        else:
            cr.set_source_rgba(0.192, 0.196, 0.267, p)
        cr.fill()
        c_lbl = self.darea.create_pango_layout("İptal")
        c_lbl.set_font_description(Pango.FontDescription("JetBrainsMono Nerd Font Medium 9.5"))
        _, cl_rect = c_lbl.get_pixel_extents()
        cr.set_source_rgba(0.804, 0.839, 0.957, p)
        cr.move_to(cancel_x + (bw - cl_rect.width) / 2, by + (bh - cl_rect.height) / 2)
        PangoCairo.show_layout(cr, c_lbl)

        self._rounded_rect(cr, ok_x, by, bw, bh, 7)
        if self.modal_hover_btn == "ok":
            cr.set_source_rgba(0.85, 0.72, 0.99, p)
        else:
            cr.set_source_rgba(0.796, 0.651, 0.969, p)
        cr.fill()
        o_lbl = self.darea.create_pango_layout("Oluştur" if "Yeni" in self.modal_title else "Kaydet")
        o_lbl.set_font_description(Pango.FontDescription("JetBrainsMono Nerd Font Bold 9.5"))
        _, ol_rect = o_lbl.get_pixel_extents()
        cr.set_source_rgba(0.067, 0.067, 0.106, p)
        cr.move_to(ok_x + (bw - ol_rect.width) / 2, by + (bh - ol_rect.height) / 2)
        PangoCairo.show_layout(cr, o_lbl)
        cr.restore()

    def open_modal(self, title: str, subtitle: str, default_text: str, callback):
        self.modal_active = True
        self.modal_closing = False
        self.modal_confirm_on_close = False
        self.modal_progress = 0.0
        self.modal_title = title
        self.modal_subtitle = subtitle
        self.modal_text = default_text
        self.modal_cursor = len(default_text)
        self.modal_select_all = True
        self.modal_callback = callback
        self.modal_hover_btn = None
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        self.darea.grab_focus()
        self.ensure_animation_loop()

    def close_modal(self, confirm=False):
        if not self.modal_active or self.modal_closing:
            return
        self.modal_closing = True
        self.modal_confirm_on_close = confirm
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        self.ensure_animation_loop()

    def _finalize_modal_close(self):
        cb = self.modal_callback
        txt = self.modal_text.strip()
        confirm = self.modal_confirm_on_close
        self.modal_active = False
        self.modal_closing = False
        self.modal_callback = None
        if confirm and cb and txt:
            cb(txt)

    def _rounded_rect(self, cr, x, y, w, h, r):
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def on_button_press(self, widget, event):
        self.darea.grab_focus()

        if self.modal_active:
            if self.modal_closing:
                return True
            mx, my, mw, mh = self.get_modal_geometry()
            bw, bh = 88, 30
            by = my + mh - 44
            cancel_x = mx + mw - 20 - bw * 2 - 8
            ok_x = mx + mw - 20 - bw

            if cancel_x <= event.x <= cancel_x + bw and by <= event.y <= by + bh:
                self.close_modal(confirm=False)
            elif ok_x <= event.x <= ok_x + bw and by <= event.y <= by + bh:
                self.close_modal(confirm=True)
            elif not (mx <= event.x <= mx + mw and my <= event.y <= my + mh):
                self.close_modal(confirm=False)
            else:
                self.modal_select_all = False
                self.darea.queue_draw()
            return True

        # Handle context menu clicks if active
        if self.ctx_active and not self.ctx_closing:
            mx, my, mw, mh = self.ctx_x, self.ctx_y, self.ctx_w, self.ctx_h
            if event.button == 1 and mx <= event.x <= mx + mw and my <= event.y <= my + mh:
                # Check mini folder color icons
                if self.ctx_folder_item is not None:
                    for rx, ry, rw, rh, icon_name, _lbl, _hex in self.ctx_color_rects:
                        if mx + rx <= event.x <= mx + rx + rw and my + ry <= event.y <= my + ry + rh:
                            self.set_folder_color(self.ctx_folder_item, icon_name)
                            self.close_context_menu()
                            return True
                # Check menu items
                for entry in self.ctx_entries:
                    if entry["type"] == "item" and entry["enabled"]:
                        ey = my + entry["y"]
                        if ey <= event.y <= ey + entry["h"]:
                            cb = entry["cb"]
                            self.close_context_menu()
                            if cb:
                                cb()
                            return True
                return True
            else:
                self.close_context_menu()
                if event.button == 1:
                    return True

        item = self.item_at(event.x, event.y)
        ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)

        if event.button == 1:
            if event.type == Gdk.EventType._2BUTTON_PRESS and item:
                self.dragging_items.clear()
                self.primary_drag_item = None
                self.is_dragging_icon = False
                self.open_item(item)
                return True

            if item:
                if ctrl:
                    if str(item.path) in self.selected_paths:
                        self.selected_paths.remove(str(item.path))
                    else:
                        self.selected_paths.add(str(item.path))
                else:
                    if str(item.path) not in self.selected_paths:
                        self.selected_paths = {str(item.path)}

                self.primary_drag_item = item
                self.dragging_items = [it for it in self.items if str(it.path) in self.selected_paths]
                if item not in self.dragging_items:
                    self.dragging_items.append(item)

                self.drag_start_x = event.x
                self.drag_start_y = event.y
                self.drag_curr_x = event.x
                self.drag_curr_y = event.y
                self.drag_offsets = {it: (event.x - it.x, event.y - it.y) for it in self.dragging_items}
                self.is_dragging_icon = False
            else:
                if not ctrl:
                    self.selected_paths.clear()
                self.rubberband_active = True
                self.rb_start_x = event.x
                self.rb_start_y = event.y
                self.rb_curr_x = event.x
                self.rb_curr_y = event.y

            self.darea.queue_draw()
            return True

        elif event.button == 3:
            if item:
                if str(item.path) not in self.selected_paths:
                    self.selected_paths = {str(item.path)}
                self.darea.queue_draw()
                self.show_item_context_menu(event, item)
            else:
                self.selected_paths.clear()
                self.darea.queue_draw()
                self.show_desktop_context_menu(event)
            return True

        return False

    def on_motion(self, widget, event):
        if self.modal_active:
            mx, my, mw, mh = self.get_modal_geometry()
            bw, bh = 88, 30
            by = my + mh - 44
            cancel_x = mx + mw - 20 - bw * 2 - 8
            ok_x = mx + mw - 20 - bw
            new_hover = None
            if cancel_x <= event.x <= cancel_x + bw and by <= event.y <= by + bh:
                new_hover = "cancel"
            elif ok_x <= event.x <= ok_x + bw and by <= event.y <= by + bh:
                new_hover = "ok"
            if new_hover != self.modal_hover_btn:
                self.modal_hover_btn = new_hover
                self.darea.queue_draw()
            return True

        if self.ctx_active and not self.ctx_closing:
            mx, my, mw, mh = self.ctx_x, self.ctx_y, self.ctx_w, self.ctx_h
            hov_idx = -1
            hov_col = -1
            if mx <= event.x <= mx + mw and my <= event.y <= my + mh:
                if self.ctx_folder_item is not None:
                    for idx, (rx, ry, rw, rh, _ic, _lbl, _hex) in enumerate(self.ctx_color_rects):
                        if mx + rx <= event.x <= mx + rx + rw and my + ry <= event.y <= my + ry + rh:
                            hov_col = idx
                            break
                if hov_col == -1:
                    for idx, entry in enumerate(self.ctx_entries):
                        if entry["type"] == "item" and entry["enabled"]:
                            ey = my + entry["y"]
                            if ey <= event.y <= ey + entry["h"]:
                                hov_idx = idx
                                break
            if hov_idx != self.ctx_hovered_idx or hov_col != self.ctx_hovered_color_idx:
                self.ctx_hovered_idx = hov_idx
                self.ctx_hovered_color_idx = hov_col
                self.darea.queue_draw()
            return True

        if self.primary_drag_item and self.dragging_items:
            if not self.is_dragging_icon and math.hypot(event.x - self.drag_start_x, event.y - self.drag_start_y) > 4:
                self.is_dragging_icon = True
                for it in self.dragging_items:
                    it.target_scale = 1.07
                self.ensure_animation_loop()

            if self.is_dragging_icon:
                self.drag_curr_x = event.x
                self.drag_curr_y = event.y
                for it in self.dragging_items:
                    ox, oy = self.drag_offsets[it]
                    it.x = event.x - ox
                    it.y = event.y - oy
                    it.target_x = it.x
                    it.target_y = it.y

                over = self.item_at(event.x, event.y, exclude_set=set(self.dragging_items))
                self.drop_target_folder = over if (over and over.path.is_dir()) else None
                self.darea.queue_draw()
            return True

        if self.rubberband_active:
            self.rb_curr_x = event.x
            self.rb_curr_y = event.y
            rx1 = min(self.rb_start_x, self.rb_curr_x)
            ry1 = min(self.rb_start_y, self.rb_curr_y)
            rx2 = max(self.rb_start_x, self.rb_curr_x)
            ry2 = max(self.rb_start_y, self.rb_curr_y)
            self.selected_paths.clear()
            for item in self.items:
                ix1, iy1 = item.x, item.y
                ix2, iy2 = item.x + CELL_W, item.y + CELL_H
                if not (ix2 < rx1 or ix1 > rx2 or iy2 < ry1 or iy1 > ry2):
                    self.selected_paths.add(str(item.path))
            self.darea.queue_draw()
            return True

        hovered = self.item_at(event.x, event.y)
        if hovered != self.hovered_item:
            self.hovered_item = hovered
            self.darea.queue_draw()
        return False

    def on_button_release(self, widget, event):
        if self.modal_active:
            return True

        if event.button == 1:
            if self.is_dragging_icon and self.primary_drag_item:
                for it in self.dragging_items:
                    it.target_scale = 1.0

                if self.drop_target_folder and self.drop_target_folder not in self.dragging_items:
                    target_dir = self.drop_target_folder.path
                    for it in self.dragging_items:
                        try:
                            shutil.move(str(it.path), str(target_dir / it.name))
                            self.positions.pop(it.name, None)
                        except Exception as e:
                            self.notify("Taşıma Hatası", str(e))
                    self.drop_target_folder = None
                    self.dragging_items.clear()
                    self.primary_drag_item = None
                    self.is_dragging_icon = False
                    self.save_positions()
                    self.reload_items()
                    return True

                max_cols = self.get_max_cols()
                max_rows = self.get_max_rows()
                occupied = {(it.col, it.row): it for it in self.items if it not in self.dragging_items}

                for it in self.dragging_items:
                    cx = it.x + CELL_W / 2.0
                    cy = it.y + CELL_H / 2.0
                    new_col = max(0, min(max_cols - 1, int((cx - MARGIN_LEFT) // CELL_W)))
                    new_row = max(0, min(max_rows - 1, int((cy - MARGIN_TOP) // CELL_H)))

                    if (new_col, new_row) in occupied:
                        occupant = occupied.pop((new_col, new_row))
                        if (it.col, it.row) not in occupied:
                            occupant.col, occupant.row = it.col, it.row
                        else:
                            fc, fr = 0, 0
                            while (fc, fr) in occupied or (fc, fr) == (new_col, new_row):
                                fr += 1
                                if fr >= max_rows:
                                    fr = 0
                                    fc += 1
                            occupant.col, occupant.row = fc, fr
                        occupant.update_target_pos(snap_immediately=False)
                        occupied[(occupant.col, occupant.row)] = occupant

                    it.col = new_col
                    it.row = new_row
                    it.update_target_pos(snap_immediately=False)
                    occupied[(new_col, new_row)] = it

                self.save_positions()
                self.ensure_animation_loop()

            self.drop_target_folder = None
            self.dragging_items.clear()
            self.primary_drag_item = None
            self.is_dragging_icon = False
            self.rubberband_active = False
            self.darea.queue_draw()
            return True
        return False

    def on_drag_data_received(self, widget, drag_context, x, y, data, info, time):
        uris = data.get_uris()
        col = max(0, min(self.get_max_cols() - 1, int((x - MARGIN_LEFT) // CELL_W)))
        row = max(0, min(self.get_max_rows() - 1, int((y - MARGIN_TOP) // CELL_H)))
        for uri in uris:
            parsed = urlparse(uri)
            if parsed.scheme == "file":
                src = Path(unquote(parsed.path))
                if src.exists() and src.parent != DESKTOP_DIR:
                    dst = self.unique_path(DESKTOP_DIR / src.name)
                    try:
                        if src.is_dir():
                            shutil.copytree(str(src), str(dst))
                        else:
                            shutil.copy2(str(src), str(dst))
                        self.positions[dst.name] = [col, row]
                        row += 1
                    except Exception as e:
                        self.notify("Kopyalama Hatası", str(e))
        self.save_positions()
        drag_context.finish(True, False, time)
        self.reload_items()

    def on_key_press(self, widget, event):
        key = event.keyval
        ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)
        shift = bool(event.state & Gdk.ModifierType.SHIFT_MASK)

        if self.ctx_active and key == Gdk.KEY_Escape:
            self.close_context_menu()
            return True

        if self.modal_active:
            if self.modal_closing:
                return True
            if key == Gdk.KEY_Escape:
                self.close_modal(confirm=False)
            elif key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                self.close_modal(confirm=True)
            elif key == Gdk.KEY_BackSpace:
                if self.modal_select_all:
                    self.modal_text = ""
                    self.modal_cursor = 0
                    self.modal_select_all = False
                elif self.modal_cursor > 0:
                    self.modal_text = self.modal_text[:self.modal_cursor - 1] + self.modal_text[self.modal_cursor:]
                    self.modal_cursor -= 1
                self.darea.queue_draw()
            elif key == Gdk.KEY_Delete:
                if self.modal_select_all:
                    self.modal_text = ""
                    self.modal_cursor = 0
                    self.modal_select_all = False
                elif self.modal_cursor < len(self.modal_text):
                    self.modal_text = self.modal_text[:self.modal_cursor] + self.modal_text[self.modal_cursor + 1:]
                self.darea.queue_draw()
            elif key == Gdk.KEY_Left:
                self.modal_select_all = False
                self.modal_cursor = max(0, self.modal_cursor - 1)
                self.darea.queue_draw()
            elif key == Gdk.KEY_Right:
                self.modal_select_all = False
                self.modal_cursor = min(len(self.modal_text), self.modal_cursor + 1)
                self.darea.queue_draw()
            elif ctrl and key in (Gdk.KEY_a, Gdk.KEY_A):
                self.modal_select_all = True
                self.darea.queue_draw()
            else:
                uni = Gdk.keyval_to_unicode(key)
                if uni and chr(uni).isprintable() and chr(uni) not in ('/', '\0'):
                    ch = chr(uni)
                    if self.modal_select_all:
                        self.modal_text = ch
                        self.modal_cursor = 1
                        self.modal_select_all = False
                    else:
                        self.modal_text = self.modal_text[:self.modal_cursor] + ch + self.modal_text[self.modal_cursor:]
                        self.modal_cursor += 1
                    self.darea.queue_draw()
            return True

        if key == Gdk.KEY_F2 and len(self.selected_paths) == 1:
            path_str = next(iter(self.selected_paths))
            item = next((it for it in self.items if str(it.path) == path_str), None)
            if item:
                self.prompt_rename(item)
            return True
        elif key == Gdk.KEY_Delete:
            self.delete_selected(permanent=shift)
            return True
        elif key == Gdk.KEY_Return and self.selected_paths:
            for it in self.items:
                if str(it.path) in self.selected_paths:
                    self.open_item(it)
            return True
        elif ctrl and key in (Gdk.KEY_a, Gdk.KEY_A):
            self.selected_paths = {str(it.path) for it in self.items}
            self.darea.queue_draw()
            return True
        elif ctrl and key in (Gdk.KEY_c, Gdk.KEY_C):
            self.copy_selected(cut=False)
            return True
        elif ctrl and key in (Gdk.KEY_x, Gdk.KEY_X):
            self.copy_selected(cut=True)
            return True
        elif ctrl and key in (Gdk.KEY_v, Gdk.KEY_V):
            self.paste_clipboard()
            return True
        elif ctrl and shift and key in (Gdk.KEY_n, Gdk.KEY_N):
            self.prompt_new_folder(None)
            return True
        return False

    def show_desktop_context_menu(self, event):
        click_pos = (event.x, event.y)
        can_paste = bool(self.clipboard_paths) or self.has_system_clipboard_files()
        entries = [
            {"label": "󰉋  Yeni Klasör", "cb": lambda: self.prompt_new_folder(click_pos)},
            {"label": "󰈔  Yeni Metin Belgesi", "cb": lambda: self.prompt_new_file(click_pos)},
            {"type": "sep"},
            {"label": "󰆒  Yapıştır", "cb": lambda: self.paste_clipboard(click_pos), "enabled": can_paste},
            {"type": "sep"},
            {"label": "󰝰  Dosya Yöneticisinde Aç", "cb": lambda: subprocess.Popen(["dolphin", str(DESKTOP_DIR)])},
            {"label": "  Burada Terminal Aç", "cb": lambda: subprocess.Popen(["kitty", "--directory", str(DESKTOP_DIR)])},
            {"label": "󰑐  Yenile", "cb": lambda: self.reload_items()},
        ]
        self.open_context_menu(event.x, event.y, entries, folder_item=None)

    def show_item_context_menu(self, event, item: DesktopItem):
        entries = [
            {"label": "󰏌  Aç", "cb": lambda: self.open_item(item)},
        ]
        if item.path.is_dir():
            entries.append({"label": "  Burada Terminal Aç", "cb": lambda: subprocess.Popen(["kitty", "--directory", str(item.path)])})
        else:
            entries.append({"label": "󰨞  Düzenleyicide Aç", "cb": lambda: subprocess.Popen(["code", str(item.path)])})

        entries.extend([
            {"type": "sep"},
            {"label": "󰆐  Kes", "cb": lambda: self.copy_selected(cut=True)},
            {"label": "󰆏  Kopyala", "cb": lambda: self.copy_selected(cut=False)},
            {"label": "󰑕  Yeniden Adlandır", "cb": lambda: self.prompt_rename(item)},
            {"type": "sep"},
            {"label": "󰩺  Çöp Kutusuna Taşı", "cb": lambda: self.delete_selected(permanent=False)},
            {"label": "󰅖  Kalıcı Olarak Sil", "cb": lambda: self.delete_selected(permanent=True)},
        ])
        self.open_context_menu(event.x, event.y, entries, folder_item=item if item.path.is_dir() else None)

    def open_item(self, item: DesktopItem):
        if item.is_desktop_file and item.exec_cmd:
            cmd = item.exec_cmd.split("%")[0].strip()
            subprocess.Popen(cmd, shell=True, cwd=str(DESKTOP_DIR))
        elif item.path.is_dir():
            subprocess.Popen(["dolphin", str(item.path)])
        else:
            subprocess.Popen(["xdg-open", str(item.path)])

    def unique_path(self, base_path: Path) -> Path:
        if not base_path.exists():
            return base_path
        stem = base_path.stem
        suffix = base_path.suffix
        counter = 2
        while True:
            candidate = base_path.parent / f"{stem} ({counter}){suffix}"
            if not candidate.exists():
                return candidate
            counter += 1

    def prompt_new_folder(self, click_pos=None):
        def create_cb(name):
            target = self.unique_path(DESKTOP_DIR / name)
            try:
                target.mkdir(parents=True, exist_ok=False)
                if click_pos:
                    col = max(0, min(self.get_max_cols() - 1, int((click_pos[0] - MARGIN_LEFT) // CELL_W)))
                    row = max(0, min(self.get_max_rows() - 1, int((click_pos[1] - MARGIN_TOP) // CELL_H)))
                    self.positions[target.name] = [col, row]
                    self.save_positions()
                self.reload_items()
            except Exception as e:
                self.notify("Hata", str(e))

        self.open_modal("Yeni Klasör", "Klasör adını girin:", "Yeni Klasör", create_cb)

    def prompt_new_file(self, click_pos=None):
        def create_cb(name):
            target = self.unique_path(DESKTOP_DIR / name)
            try:
                target.write_text("", encoding="utf-8")
                if click_pos:
                    col = max(0, min(self.get_max_cols() - 1, int((click_pos[0] - MARGIN_LEFT) // CELL_W)))
                    row = max(0, min(self.get_max_rows() - 1, int((click_pos[1] - MARGIN_TOP) // CELL_H)))
                    self.positions[target.name] = [col, row]
                    self.save_positions()
                self.reload_items()
            except Exception as e:
                self.notify("Hata", str(e))

        self.open_modal("Yeni Metin Belgesi", "Dosya adını girin:", "Yeni Belge.txt", create_cb)

    def prompt_rename(self, item: DesktopItem):
        def rename_cb(new_name):
            if new_name and new_name != item.name:
                dst = item.path.parent / new_name
                if dst.exists():
                    self.notify("Hata", "Bu isimde bir dosya veya klasör zaten var.")
                    return
                try:
                    old_pos = [item.col, item.row]
                    old_color = self.folder_colors.pop(item.name, None)
                    item.path.rename(dst)
                    self.positions.pop(item.name, None)
                    self.positions[new_name] = old_pos
                    if old_color:
                        self.folder_colors[new_name] = old_color
                    self.save_positions()
                    self.selected_paths = {str(dst)}
                    self.reload_items()
                except Exception as e:
                    self.notify("Hata", str(e))

        self.open_modal("Yeniden Adlandır", f"'{item.name}' için yeni ad:", item.name, rename_cb)

    def copy_selected(self, cut=False):
        self.clipboard_paths = [Path(p) for p in self.selected_paths if Path(p).exists()]
        self.clipboard_is_cut = cut

    def has_system_clipboard_files(self):
        try:
            out = subprocess.check_output(["wl-paste", "--list-types"], timeout=0.5).decode()
            return "text/uri-list" in out
        except Exception:
            return False

    def paste_clipboard(self, click_pos=None):
        sources = list(self.clipboard_paths)
        is_cut = self.clipboard_is_cut

        if not sources and self.has_system_clipboard_files():
            try:
                raw = subprocess.check_output(["wl-paste", "--type", "text/uri-list"], timeout=1.0).decode()
                for line in raw.splitlines():
                    line = line.strip()
                    if line.startswith("file://"):
                        p = Path(unquote(urlparse(line).path))
                        if p.exists():
                            sources.append(p)
                is_cut = False
            except Exception:
                pass

        if not sources:
            return

        col, row = None, None
        if click_pos:
            col = max(0, min(self.get_max_cols() - 1, int((click_pos[0] - MARGIN_LEFT) // CELL_W)))
            row = max(0, min(self.get_max_rows() - 1, int((click_pos[1] - MARGIN_TOP) // CELL_H)))

        for src in sources:
            if not src.exists():
                continue
            dst = self.unique_path(DESKTOP_DIR / src.name)
            try:
                if is_cut:
                    shutil.move(str(src), str(dst))
                else:
                    if src.is_dir():
                        shutil.copytree(str(src), str(dst))
                    else:
                        shutil.copy2(str(src), str(dst))
                if col is not None and row is not None:
                    self.positions[dst.name] = [col, row]
                    row += 1
            except Exception as e:
                self.notify("Yapıştırma Hatası", str(e))

        if is_cut:
            self.clipboard_paths.clear()
        self.save_positions()
        self.reload_items()

    def delete_selected(self, permanent=False):
        for p_str in list(self.selected_paths):
            p = Path(p_str)
            if not p.exists():
                continue
            try:
                if permanent:
                    if p.is_dir() and not p.is_symlink():
                        shutil.rmtree(str(p))
                    else:
                        p.unlink()
                else:
                    gfile = Gio.File.new_for_path(str(p))
                    gfile.trash(None)
                self.positions.pop(p.name, None)
                self.folder_colors.pop(p.name, None)
            except Exception as e:
                self.notify("Silme Hatası", str(e))
        self.selected_paths.clear()
        self.save_positions()
        self.reload_items()

    def notify(self, title, body):
        subprocess.Popen(["notify-send", "-a", "Masaüstü", title, body])


def main():
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )
    win = DesktopManager()
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
