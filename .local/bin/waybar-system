#!/usr/bin/env python3
import sys
import os
import json
import psutil
import subprocess

STATE_FILE = f"/run/user/{os.getuid()}/waybar_cpu_stat"

def get_cpu_delta():
    try:
        with open("/proc/stat", "r") as f:
            fields = [float(x) for x in f.readline().split()[1:]]
        idle = fields[3] + fields[4]
        total = sum(fields)
        cpu = 0.0
        if os.path.exists(STATE_FILE):
            try:
                with open(STATE_FILE, "r") as f:
                    prev_total, prev_idle = [float(x) for x in f.read().split()]
                d_total = total - prev_total
                d_idle = idle - prev_idle
                if d_total > 0:
                    cpu = 100.0 * (1.0 - d_idle / d_total)
            except Exception:
                pass
        with open(STATE_FILE, "w") as f:
            f.write(f"{total} {idle}")
        return int(round(max(0.0, min(100.0, cpu))))
    except Exception:
        return 0

def get_cpu_temp():
    try:
        temps = psutil.sensors_temperatures()
        if not temps:
            return None
        if 'coretemp' in temps:
            for entry in temps['coretemp']:
                if 'Package id 0' in entry.label:
                    return int(round(entry.current))
            if temps['coretemp']:
                return int(round(temps['coretemp'][0].current))
        for k in ('k10temp', 'zenpower', 'acpitz', 'cpu_thermal'):
            if k in temps and temps[k]:
                return int(round(temps[k][0].current))
        for name, entries in temps.items():
            if 'cpu' in name.lower() and entries:
                return int(round(entries[0].current))
    except Exception:
        pass
    return None

def get_metrics():
    # CPU
    cpu = get_cpu_delta()
    cpu_temp = get_cpu_temp()
    cpu_temp_str = f" ({cpu_temp}°C)" if cpu_temp is not None else ""
    ram = psutil.virtual_memory()
    ram_pct = int(round(ram.percent))
    ram_used_gb = ram.used / (1024 ** 3)
    ram_total_gb = ram.total / (1024 ** 3)

    # NVIDIA GPU
    nv_gpu = 0
    nv_temp = 0
    nv_mem = 0
    try:
        res = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu,temperature.gpu,memory.used", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=0.3
        )
        if res.returncode == 0:
            parts = [p.strip() for p in res.stdout.strip().split(",")]
            if len(parts) >= 3:
                nv_gpu = int(parts[0])
                nv_temp = int(parts[1])
                nv_mem = int(parts[2])
    except Exception:
        pass

    # Intel GPU status
    intel_freq = 0
    try:
        with open("/sys/class/drm/card1/device/drm/card1/gt_act_freq_mhz", "r") as f:
            intel_freq = int(f.read().strip())
    except Exception:
        pass

    intel_desc = f"{intel_freq} MHz" if intel_freq > 0 else "Boşta / Düşük güç"

    # Total GPU usage to display
    gpu_disp = nv_gpu

    tooltip_lines = [
        f"CPU: %{cpu}{cpu_temp_str}",
        f"RAM: {ram_used_gb:.1f}/{ram_total_gb:.0f} GB (%{ram_pct})"
    ]
    if nv_gpu > 0 or nv_temp > 0:
        tooltip_lines.append(f"GPU: %{nv_gpu} ({nv_temp}°C)")
    tooltip = chr(10).join(tooltip_lines)

    data = {
        "text": f" {cpu}%  󰘚 {ram_pct}%",
        "tooltip": tooltip,
        "class": "system-active" if (cpu > 70 or ram_pct > 80 or gpu_disp > 70) else "system-normal"
    }
    return data

if __name__ == "__main__":
    try:
        data = get_metrics()
        print(json.dumps(data))
    except Exception as e:
        print(json.dumps({"text": " --%  󰘚 --%", "tooltip": str(e)}))
