#!/usr/bin/env python3
import sys
import os
import glob
import json
import psutil
import subprocess

STATE_FILE = f"/run/user/{os.getuid()}/waybar_cpu_stat"

def get_cpu_delta():
    try:
        with open("/proc/stat", "r") as f:
            fields = [float(x) for x in f.readline().split()[1:]]
        idle = fields[3] + fields[4]
        total = sum(fields)
        cpu = 0.0
        if os.path.exists(STATE_FILE):
            try:
                with open(STATE_FILE, "r") as f:
                    prev_total, prev_idle = [float(x) for x in f.read().split()]
                d_total = total - prev_total
                d_idle = idle - prev_idle
                if d_total > 0:
                    cpu = 100.0 * (1.0 - d_idle / d_total)
            except Exception:
                pass
        with open(STATE_FILE, "w") as f:
            f.write(f"{total} {idle}")
        return int(round(max(0.0, min(100.0, cpu))))
    except Exception:
        return 0

def get_cpu_temp():
    try:
        temps = psutil.sensors_temperatures()
        if not temps:
            return None
        if 'coretemp' in temps:
            for entry in temps['coretemp']:
                if 'Package id 0' in entry.label:
                    return int(round(entry.current))
            if temps['coretemp']:
                return int(round(temps['coretemp'][0].current))
        for k in ('k10temp', 'zenpower', 'acpitz', 'cpu_thermal'):
            if k in temps and temps[k]:
                return int(round(temps[k][0].current))
        for name, entries in temps.items():
            if 'cpu' in name.lower() and entries:
                return int(round(entries[0].current))
    except Exception:
        pass
    return None

def get_metrics():
    # CPU
    cpu = get_cpu_delta()
    cpu_temp = get_cpu_temp()
    cpu_temp_str = f" ({cpu_temp}°C)" if cpu_temp is not None else ""
    ram = psutil.virtual_memory()
    ram_pct = int(round(ram.percent))
    ram_used_gb = ram.used / (1024 ** 3)
    ram_total_gb = ram.total / (1024 ** 3)

    # Universal GPU status (NVIDIA / AMD / Intel)
    nv_gpu = 0
    nv_temp = 0
    amd_gpu = 0
    amd_temp = 0
    intel_freq = 0
    intel_max = 1400
    try:
        res = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu,temperature.gpu,memory.used", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=0.3
        )
        if res.returncode == 0:
            parts = [p.strip() for p in res.stdout.strip().split(",")]
            if len(parts) >= 3:
                nv_gpu = int(parts[0])
                nv_temp = int(parts[1])
    except Exception:
        pass

    for fpath in glob.glob("/sys/class/drm/card[0-9]*/gt_act_freq_mhz") + glob.glob("/sys/class/drm/card[0-9]*/device/tile*/gt*/freq*/act_freq"):
        try:
            intel_freq = max(intel_freq, int(open(fpath).read().strip()))
            max_p = os.path.join(os.path.dirname(fpath), "gt_max_freq_mhz")
            if os.path.exists(max_p):
                intel_max = max(300, int(open(max_p).read().strip()))
        except Exception:
            pass
    for busy_path in glob.glob("/sys/class/drm/card[0-9]*/device/gpu_busy_percent"):
        try:
            amd_gpu = max(amd_gpu, int(open(busy_path).read().strip()))
        except Exception:
            pass

    try:
        temps = psutil.sensors_temperatures() or {}
        if "amdgpu" in temps and temps["amdgpu"]:
            amd_temp = int(round(temps["amdgpu"][0].current))
    except Exception:
        pass

    intel_pct = int(round((intel_freq / float(max(1, intel_max))) * 100)) if intel_freq > 0 else 0
    gpu_disp = max(nv_gpu, amd_gpu, min(100, intel_pct))
    gpu_temp = nv_temp if nv_temp > 0 else amd_temp

    tooltip_lines = [
        f"CPU: %{cpu}{cpu_temp_str}",
        f"RAM: {ram_used_gb:.1f}/{ram_total_gb:.0f} GB (%{ram_pct})"
    ]
    if gpu_disp > 0 or gpu_temp > 0:
        t_str = f" ({gpu_temp}°C)" if gpu_temp > 0 else ""
        tooltip_lines.append(f"GPU: %{gpu_disp}{t_str}")
    tooltip = chr(10).join(tooltip_lines)

    data = {
        "text": f" {cpu}%  󰘚 {ram_pct}%",
        "tooltip": tooltip,
        "class": "system-active" if (cpu > 70 or ram_pct > 80 or gpu_disp > 70) else "system-normal"
    }
    return data

if __name__ == "__main__":
    try:
        data = get_metrics()
        print(json.dumps(data))
    except Exception as e:
        print(json.dumps({"text": " --%  󰘚 --%", "tooltip": str(e)}))
