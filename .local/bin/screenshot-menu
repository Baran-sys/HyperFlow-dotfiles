class SnippingBar(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("Snipping Tool")
        self.set_resizable(False)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 14)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        self.connect("destroy", Gtk.main_quit)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS_STYLE)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.settings = load_settings()
        recording_pid = is_recording_active()

        self.main_container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.main_container.get_style_context().add_class("snipping-pill")
        self.add(self.main_container)

        self.top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        self.main_container.pack_start(self.top_row, False, False, 0)

        # 1. Rectangle (Area) Button
        self.btn_area = Gtk.Button()
        self.btn_area.get_style_context().add_class("snip-btn")
        box_area = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        lbl_icon_area = Gtk.Label()
        lbl_icon_area.set_markup("<span font='16px'>󰒅</span>")
        lbl_text_area = Gtk.Label(label="Area")
        box_area.pack_start(lbl_icon_area, False, False, 0)
        box_area.pack_start(lbl_text_area, False, False, 0)
        self.btn_area.add(box_area)
        self.btn_area.set_tooltip_text("Rectangular Selection [1 / R / A]")
        self.btn_area.connect("clicked", lambda b: self.trigger_capture("area"))
        self.top_row.pack_start(self.btn_area, False, False, 0)

        # 2. Window Button
        self.btn_window = Gtk.Button()
        self.btn_window.get_style_context().add_class("snip-btn")
        box_win = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        lbl_icon_win = Gtk.Label()
        lbl_icon_win.set_markup("<span font='16px'>󰖲</span>")
        lbl_text_win = Gtk.Label(label="Window")
        box_win.pack_start(lbl_icon_win, False, False, 0)
        box_win.pack_start(lbl_text_win, False, False, 0)
        self.btn_window.add(box_win)
        self.btn_window.set_tooltip_text("Window Snip [2 / W]")
        self.btn_window.connect("clicked", lambda b: self.trigger_capture("window"))
        self.top_row.pack_start(self.btn_window, False, False, 0)

        # 3. Fullscreen Button
        self.btn_screen = Gtk.Button()
        self.btn_screen.get_style_context().add_class("snip-btn")
        box_screen = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        lbl_icon_screen = Gtk.Label()
        lbl_icon_screen.set_markup("<span font='16px'>󰹑</span>")
        lbl_text_screen = Gtk.Label(label="Screen")
        box_screen.pack_start(lbl_icon_screen, False, False, 0)
        box_screen.pack_start(lbl_text_screen, False, False, 0)
        self.btn_screen.add(box_screen)
        self.btn_screen.set_tooltip_text("Full Screen Snip [3 / F / S]")
        self.btn_screen.connect("clicked", lambda b: self.trigger_capture("screen"))
        self.top_row.pack_start(self.btn_screen, False, False, 0)

        # Separator 1
        sep1 = Gtk.Box()
        sep1.get_style_context().add_class("snip-sep")
        self.top_row.pack_start(sep1, False, False, 2)

        # 4. Record Button (or Stop Recording if active)
        self.btn_record = Gtk.Button()
        self.btn_record.get_style_context().add_class("snip-btn")
        box_rec = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        self.lbl_icon_rec = Gtk.Label()
        self.lbl_text_rec = Gtk.Label()
        box_rec.pack_start(self.lbl_icon_rec, False, False, 0)
        box_rec.pack_start(self.lbl_text_rec, False, False, 0)
        self.btn_record.add(box_rec)

        if recording_pid:
            self.lbl_icon_rec.set_markup("<span font='16px'>󰙦</span>")
            self.lbl_text_rec.set_text("Stop")
            self.btn_record.get_style_context().add_class("rec-active")
            self.btn_record.set_tooltip_text("Stop Active Recording [4 / V]")
            self.btn_record.connect("clicked", lambda b: self.trigger_stop_rec())
        else:
            self.lbl_icon_rec.set_markup("<span font='16px'></span>")
            self.lbl_text_rec.set_text("Record")
            self.btn_record.get_style_context().add_class("rec-btn")
            self.btn_record.set_tooltip_text("Start Screen Recording [4 / V]")
            self.btn_record.connect("clicked", lambda b: self.trigger_start_rec())

        self.top_row.pack_start(self.btn_record, False, False, 0)

        # 5. Settings Gear Button
        self.btn_gear = Gtk.Button()
        self.btn_gear.get_style_context().add_class("snip-btn")
        lbl_gear = Gtk.Label()
        lbl_gear.set_markup("<span font='16px'>󰒓</span>")
        self.btn_gear.add(lbl_gear)
        self.btn_gear.set_tooltip_text("Recording Settings (Resolution & FPS) [G / O]")
        self.btn_gear.connect("clicked", lambda b: self.toggle_settings_dropdown())
        self.top_row.pack_start(self.btn_gear, False, False, 0)

        # Separator 2
        sep2 = Gtk.Box()
        sep2.get_style_context().add_class("snip-sep")
        self.top_row.pack_start(sep2, False, False, 2)

        # 6. Close / Cancel Button
        self.btn_close = Gtk.Button()
        self.btn_close.get_style_context().add_class("snip-btn")
        self.btn_close.get_style_context().add_class("close-btn")
        lbl_icon_close = Gtk.Label()
        lbl_icon_close.set_markup("<span font='16px'>󰅖</span>")
        self.btn_close.add(lbl_icon_close)
        self.btn_close.set_tooltip_text("Cancel [Esc]")
        self.btn_close.connect("clicked", lambda b: self.destroy())
        self.top_row.pack_start(self.btn_close, False, False, 0)

        # 7. Dropdown Panel (Revealer)
        self.revealer = Gtk.Revealer()
        self.revealer.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
        self.revealer.set_reveal_child(False)
        self.main_container.pack_start(self.revealer, False, False, 0)

        self.panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.panel.get_style_context().add_class("dropdown-panel")
        self.revealer.add(self.panel)

        # Resolution Row
        row_res = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        lbl_res = Gtk.Label(label="Resolution:")
        lbl_res.get_style_context().add_class("option-label")
        row_res.pack_start(lbl_res, False, False, 0)
        group_res = None
        for res_val in ["1080p", "720p", "480p"]:
            rb = Gtk.RadioButton.new_with_label_from_widget(group_res, res_val)
            group_res = rb
            rb.set_mode(False)
            rb.get_style_context().add_class("choice-btn")
            if self.settings.get("resolution") == res_val:
                rb.set_active(True)
            rb.connect("toggled", self.make_res_callback(res_val))
            row_res.pack_start(rb, False, False, 0)
        self.panel.pack_start(row_res, False, False, 0)

        # FPS Row
        row_fps = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        lbl_fps = Gtk.Label(label="Framerate: ")
        lbl_fps.get_style_context().add_class("option-label")
        row_fps.pack_start(lbl_fps, False, False, 0)
        group_fps = None
        for fps_val in ["60 FPS", "30 FPS"]:
            rb = Gtk.RadioButton.new_with_label_from_widget(group_fps, fps_val)
            group_fps = rb
            rb.set_mode(False)
            rb.get_style_context().add_class("choice-btn")
            if self.settings.get("fps") == fps_val:
                rb.set_active(True)
            rb.connect("toggled", self.make_fps_callback(fps_val))
            row_fps.pack_start(rb, False, False, 0)
        self.panel.pack_start(row_fps, False, False, 0)

        # Target Area Row
        row_area = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        lbl_area = Gtk.Label(label="Capture:   ")
        lbl_area.get_style_context().add_class("option-label")
        row_area.pack_start(lbl_area, False, False, 0)
        group_area = None
        for area_val in ["Selection", "Fullscreen"]:
            rb = Gtk.RadioButton.new_with_label_from_widget(group_area, area_val)
            group_area = rb
            rb.set_mode(False)
            rb.get_style_context().add_class("choice-btn")
            if self.settings.get("area") == area_val:
                rb.set_active(True)
            rb.connect("toggled", self.make_area_callback(area_val))
            row_area.pack_start(rb, False, False, 0)
        self.panel.pack_start(row_area, False, False, 0)

        # Keyboard event
        self.connect("key-press-event", self.on_key_press)

    def toggle_settings_dropdown(self):
        cur = self.revealer.get_reveal_child()
        self.revealer.set_reveal_child(not cur)
        if not cur:
            self.btn_gear.get_style_context().add_class("active")
        else:
            self.btn_gear.get_style_context().remove_class("active")

    def make_res_callback(self, val):
        def _cb(widget):
            if widget.get_active():
                self.settings["resolution"] = val
                save_settings(self.settings)
        return _cb

    def make_fps_callback(self, val):
        def _cb(widget):
            if widget.get_active():
                self.settings["fps"] = val
                save_settings(self.settings)
        return _cb

    def make_area_callback(self, val):
        def _cb(widget):
            if widget.get_active():
                self.settings["area"] = val
                save_settings(self.settings)
        return _cb

    def on_key_press(self, widget, event):
        kv = event.keyval
        if kv in (Gdk.KEY_Escape, Gdk.KEY_q, Gdk.KEY_Q):
            self.destroy()
            return True
        elif kv in (Gdk.KEY_1, Gdk.KEY_r, Gdk.KEY_R, Gdk.KEY_a, Gdk.KEY_A):
            self.trigger_capture("area")
            return True
        elif kv in (Gdk.KEY_2, Gdk.KEY_w, Gdk.KEY_W):
            self.trigger_capture("window")
            return True
        elif kv in (Gdk.KEY_3, Gdk.KEY_f, Gdk.KEY_F, Gdk.KEY_s, Gdk.KEY_S):
            self.trigger_capture("screen")
            return True
        elif kv in (Gdk.KEY_4, Gdk.KEY_v, Gdk.KEY_V):
            if is_recording_active():
                self.trigger_stop_rec()
            else:
                self.trigger_start_rec()
            return True
        elif kv in (Gdk.KEY_g, Gdk.KEY_G, Gdk.KEY_o, Gdk.KEY_O):
            self.toggle_settings_dropdown()
            return True
        return False

    def trigger_capture(self, mode):
        self.hide()
        self.destroy()
        while Gtk.events_pending():
            Gtk.main_iteration()

        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--capture", mode])
        sys.exit(0)

    def trigger_start_rec(self):
        self.hide()
        self.destroy()
        while Gtk.events_pending():
            Gtk.main_iteration()

        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--record"])
        sys.exit(0)

    def trigger_stop_rec(self):
        self.hide()
        self.destroy()
        while Gtk.events_pending():
            Gtk.main_iteration()

        stop_recording()
        sys.exit(0)


def main():
    app = SnippingBar()
    app.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
