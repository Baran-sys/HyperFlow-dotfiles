#!/usr/bin/env python3
"""
HyprFlow Windows-Style Top Floating Snipping & Screen Recording Tool Bar
- Floating pill centered at the top of the focused monitor.
- Screenshot Modes:
    1. Rectangular Selection (Area) [1 / R / A]
    2. Window Capture (Window) [2 / W]
    3. Fullscreen (Screen) [3 / F / S]
- Screen Recording:
    4. Screen Recording (Record / Stop) [4 / V]
    5. Settings Gear (Dropdown for Resolution, FPS & Target) [G / O]
- Dismiss / Cancel [Esc / Q]
- Theme: Catppuccin Mocha Glass (#1e1e2e / #cba6f7).
"""

import os
import sys
import time
import json
import signal
import subprocess
import threading

PID_FILE = "/tmp/screenrec.pid"
META_FILE = "/tmp/screenrec.meta"
LOCK_FILE = "/tmp/screenshot_menu.pid"
SETTINGS_FILE = os.path.expanduser("~/.config/hypr/recording_settings.json")


def load_settings():
    defaults = {"resolution": "1080p", "fps": "60 FPS", "area": "Selection"}
    try:
        if os.path.exists(SETTINGS_FILE):
            with open(SETTINGS_FILE, "r") as f:
                data = json.load(f)
                defaults.update(data)
    except Exception:
        pass
    return defaults


def save_settings(data):
    try:
        os.makedirs(os.path.dirname(SETTINGS_FILE), exist_ok=True)
        with open(SETTINGS_FILE, "w") as f:
            json.dump(data, f, indent=2)
    except Exception:
        pass


def is_recording_active():
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                content = f.read().strip()
            if content:
                pid = int(content)
                os.kill(pid, 0)
                return pid
        except Exception:
            try:
                os.remove(PID_FILE)
            except Exception:
                pass
    return None


def stop_recording():
    pid = is_recording_active()
    if not pid:
        return False
    try:
        os.kill(pid, signal.SIGINT)
    except Exception:
        pass

    for _ in range(50):
        try:
            os.kill(pid, 0)
            time.sleep(0.05)
        except Exception:
            break

    filepath = None
    filename = None
    if os.path.exists(META_FILE):
        try:
            with open(META_FILE, "r") as f:
                meta = json.load(f)
                filepath = meta.get("filepath")
                filename = meta.get("filename")
        except Exception:
            pass
        try:
            os.remove(META_FILE)
        except Exception:
            pass

    try:
        if os.path.exists(PID_FILE):
            os.remove(PID_FILE)
    except Exception:
        pass

    if filepath and os.path.exists(filepath):
        try:
            proc = subprocess.Popen([
                "notify-send",
                "-a", "Screen Recorder",
                "-i", "video-x-generic",
                "-A", "open=Open Video",
                "Recording Saved",
                f"Saved to {filename or os.path.basename(filepath)}"
            ], stdout=subprocess.PIPE, text=True)

            def _open_action(p, fp):
                try:
                    out, _ = p.communicate(timeout=10)
                    if "open" in (out or ""):
                        subprocess.Popen(["xdg-open", fp])
                except Exception:
                    pass

            threading.Thread(target=_open_action, args=(proc, filepath), daemon=True).start()
        except Exception:
            pass
    return True


# ==============================================================================
# Background CLI Workers
# ==============================================================================

if len(sys.argv) > 1 and sys.argv[1] == "--stop-rec":
    stop_recording()
    sys.exit(0)

if len(sys.argv) > 1 and sys.argv[1] == "--capture":
    mode = sys.argv[2] if len(sys.argv) > 2 else "area"
    time.sleep(0.18)

    if os.path.exists(os.path.expanduser("~/Resimler")):
        save_dir = os.path.expanduser("~/Resimler/Screenshots")
    else:
        save_dir = os.path.expanduser("~/Pictures/Screenshots")
    os.makedirs(save_dir, exist_ok=True)

    filename = time.strftime("Screenshot_%Y%m%d_%H%M%S.png")
    filepath = os.path.join(save_dir, filename)

    geom = None
    if mode == "area":
        slurp_cmd = [
            "slurp", "-d",
            "-b", "#1e1e2e55",
            "-c", "#cba6f7ff",
            "-s", "#cba6f733",
            "-w", "2"
        ]
        res = subprocess.run(slurp_cmd, capture_output=True, text=True)
        geom = res.stdout.strip()
        if not geom:
            sys.exit(0)
    elif mode == "window":
        try:
            ws_res = subprocess.check_output(["hyprctl", "activeworkspace", "-j"]).decode()
            active_ws_id = json.loads(ws_res).get("id")
            clients_res = subprocess.check_output(["hyprctl", "clients", "-j"]).decode()
            clients = json.loads(clients_res)
            boxes = []
            for c in clients:
                if c.get("workspace", {}).get("id") == active_ws_id:
                    at = c.get("at", [0, 0])
                    size = c.get("size", [0, 0])
                    boxes.append(f"{at[0]},{at[1]} {size[0]}x{size[1]}")
            boxes_str = "\n".join(boxes)
        except Exception:
            boxes_str = ""

        slurp_cmd = [
            "slurp",
            "-b", "#1e1e2e55",
            "-c", "#cba6f7ff",
            "-s", "#cba6f733",
            "-w", "2"
        ]
        if boxes_str:
            slurp_cmd.append("-r")
            res = subprocess.run(slurp_cmd, input=boxes_str, capture_output=True, text=True)
        else:
            res = subprocess.run(slurp_cmd, capture_output=True, text=True)
        geom = res.stdout.strip()
        if not geom:
            sys.exit(0)

    if geom:
        capture_cmd = ["grim", "-g", geom, filepath]
    else:
        capture_cmd = ["grim", filepath]

    capture_res = subprocess.run(capture_cmd)
    if capture_res.returncode != 0 or not os.path.exists(filepath):
        sys.exit(1)

    try:
        with open(filepath, "rb") as f:
            subprocess.run(["wl-copy", "-t", "image/png"], stdin=f)
    except Exception:
        pass

    try:
        proc = subprocess.Popen([
            "notify-send",
            "-a", "Screenshot",
            "-i", filepath,
            "-A", "open=Open",
            "Screenshot Captured",
            f"Saved to {filename}\nCopied to clipboard."
        ], stdout=subprocess.PIPE, text=True)

        def _open_shot(p, fp):
            try:
                out, _ = p.communicate(timeout=8)
                if "open" in (out or ""):
                    subprocess.Popen(["xdg-open", fp])
            except Exception:
                pass
        threading.Thread(target=_open_shot, args=(proc, filepath), daemon=True).start()
    except Exception:
        subprocess.Popen(["notify-send", "-a", "Screenshot", "-i", filepath, "Screenshot Captured", f"Saved to {filename}"])

    sys.exit(0)

if len(sys.argv) > 1 and sys.argv[1] == "--record":
    time.sleep(0.18)
    settings = load_settings()
    res_choice = settings.get("resolution", "1080p")
    fps_choice = settings.get("fps", "60 FPS")
    area_choice = settings.get("area", "Selection")

    fps_num = 60 if "60" in str(fps_choice) else 30

    if os.path.exists(os.path.expanduser("~/Videolar")):
        save_dir = os.path.expanduser("~/Videolar/Recordings")
    else:
        save_dir = os.path.expanduser("~/Videos/Recordings")
    os.makedirs(save_dir, exist_ok=True)

    filename = time.strftime("Recording_%Y%m%d_%H%M%S.mp4")
    filepath = os.path.join(save_dir, filename)

    geom = None
    if area_choice == "Selection":
        slurp_cmd = [
            "slurp", "-d",
            "-b", "#1e1e2e55",
            "-c", "#cba6f7ff",
            "-s", "#cba6f733",
            "-w", "2"
        ]
        res = subprocess.run(slurp_cmd, capture_output=True, text=True)
        geom = res.stdout.strip()
        if not geom:
            sys.exit(0)

    cmd = ["wf-recorder"]
    if geom:
        cmd.extend(["-g", geom])
    cmd.extend(["-r", str(fps_num)])

    if res_choice == "720p":
        cmd.extend(["-F", "scale=-2:720"])
    elif res_choice == "480p":
        cmd.extend(["-F", "scale=-2:480"])
    elif res_choice == "1080p" and not geom:
        cmd.extend(["-F", "scale=-2:1080"])

    cmd.extend(["-f", filepath])

    try:
        proc = subprocess.Popen(cmd)
        with open(PID_FILE, "w") as f:
            f.write(str(proc.pid))
        with open(META_FILE, "w") as f:
            json.dump({"filepath": filepath, "filename": filename, "pid": proc.pid}, f)

        notify_proc = subprocess.Popen([
            "notify-send",
            "-a", "Screen Recorder",
            "-i", "media-record",
            "-A", "stop=Stop Recording",
            "Recording Started",
            f"Format: {res_choice} @ {fps_num}fps\nClick 'Stop Recording' or press PrintScreen to finish."
        ], stdout=subprocess.PIPE, text=True)

        def _watch_notify(np, rp):
            try:
                out, _ = np.communicate()
                if "stop" in (out or ""):
                    stop_recording()
            except Exception:
                pass
        threading.Thread(target=_watch_notify, args=(notify_proc, proc), daemon=True).start()
    except Exception as e:
        subprocess.Popen(["notify-send", "-a", "Screen Recorder", "Recording Failed", str(e)])
        sys.exit(1)

    sys.exit(0)


# ==============================================================================
# GUI: Top Floating Pill Toolbar
# ==============================================================================

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('GtkLayerShell', '0.1')
from gi.repository import Gtk, Gdk, GLib, GtkLayerShell


def toggle_or_lock():
    my_pid = os.getpid()
    if os.path.exists(LOCK_FILE):
        try:
            with open(LOCK_FILE, "r") as f:
                content = f.read().strip()
            if content:
                old_pid = int(content)
                if old_pid != my_pid:
                    try:
                        os.kill(old_pid, 0)
                        os.kill(old_pid, signal.SIGTERM)
                        try:
                            os.remove(LOCK_FILE)
                        except Exception:
                            pass
                        sys.exit(0)
                    except (ProcessLookupError, OSError):
                        pass
        except Exception:
            pass
    try:
        with open(LOCK_FILE, "w") as f:
            f.write(str(my_pid))
    except Exception:
        pass

    def _cleanup_lock():
        try:
            if os.path.exists(LOCK_FILE):
                with open(LOCK_FILE, "r") as f:
                    if f.read().strip() == str(my_pid):
                        os.remove(LOCK_FILE)
        except Exception:
            pass
    import atexit
    atexit.register(_cleanup_lock)

    def _sigterm_handler(sig, frame):
        _cleanup_lock()
        sys.exit(0)
    signal.signal(signal.SIGTERM, _sigterm_handler)


toggle_or_lock()

CSS_STYLE = b"""
