#!/usr/bin/env bash

STATE_FILE="/tmp/caffeine_active"

if pgrep -x hypridle >/dev/null; then
    # hypridle is running -> activate caffeine
    pkill -x hypridle
    touch "$STATE_FILE"
    notify-send -a "Caffeine" "Caffeine Active" "Screen lock and sleep have been inhibited." -t 2500
    echo "active"
else
    # hypridle is not running -> deactivate caffeine
    rm -f "$STATE_FILE"
    hypridle >/dev/null 2>&1 &
    notify-send -a "Caffeine" "Caffeine Off" "Screen lock and sleep have been restored." -t 2500
    echo "inactive"
fi
