#!/usr/bin/env bash

STATE_FILE="/tmp/caffeine_active"

if pgrep -x hypridle >/dev/null; then
    # hypridle is running -> activate caffeine
    pkill -x hypridle
    touch "$STATE_FILE"
    notify-send -a "Caffeine" "Caffeine Aktif" "Ekran kilitlenmesi ve uyku modu durduruldu." -t 2500
    echo "active"
else
    # hypridle is not running -> deactivate caffeine
    rm -f "$STATE_FILE"
    hypridle >/dev/null 2>&1 &
    notify-send -a "Caffeine" "Caffeine Kapalı" "Ekran kilidi ve uyku modu yeniden devrede." -t 2500
    echo "inactive"
fi
