#!/bin/bash
# Universal Smart Focus Launcher
"$@" &
PID=$!
for i in {1..35}; do
    sleep 0.02
    if hyprctl clients -j 2>/dev/null | grep -q "\"pid\": $PID"; then
        hyprctl eval "hl.config({ cursor = { no_warps = true } }); hl.dispatch(hl.dsp.focus({ window = 'pid:$PID' })); hl.config({ cursor = { no_warps = false } })" > /dev/null 2>&1
        break
    fi
done
