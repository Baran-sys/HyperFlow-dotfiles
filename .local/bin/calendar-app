    try:
        locale.setlocale(locale.LC_ALL, loc)
        os.environ['LC_ALL'] = loc
        os.environ['LC_TIME'] = loc
        os.environ['LANG'] = loc
        break
    except Exception:
        pass

sys.path.insert(0, os.path.expanduser('~/.local/bin'))
from waybar_focus import SmartFocus, fast_toggle_or_lock
