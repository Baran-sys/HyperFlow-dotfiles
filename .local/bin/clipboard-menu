#!/usr/bin/env bash

# Toggle: If rofi is already open, close it
if pkill -x rofi; then
    exit 0
fi

# Start transparent full-screen overlay to detect clicks outside Rofi
slurp -b '#00000000' -c '#00000000' -s '#00000000' >/dev/null 2>&1 &
SLURP_PID=$!

# Monitor loop: if slurp detects a click outside, kill rofi
(
    while kill -0 "$SLURP_PID" 2>/dev/null; do
        if ! pgrep -x rofi >/dev/null; then
            kill "$SLURP_PID" 2>/dev/null
            exit 0
        fi
        sleep 0.05
    done
    pkill -x rofi 2>/dev/null
) &
MONITOR_PID=$!

# Read up to 50 items from cliphist
mapfile -t raw_items < <(cliphist list | head -n 50)
if [ ${#raw_items[@]} -eq 0 ]; then
    kill "$SLURP_PID" "$MONITOR_PID" 2>/dev/null
    exit 0
fi

# Strip the leading counter/ID (<id>\t) for clean display in rofi
display_items=()
for item in "${raw_items[@]}"; do
    display_items+=("${item#*$'\t'}")
done

# Run rofi in spotlight style without leading numbers (-format i returns the selected item index)
selected_idx=$(printf '%s\n' "${display_items[@]}" | rofi -dmenu -format i -p "󰅌 " -theme ~/.config/rofi/clipboard.rasi)
rofi_status=$?

# Cleanup
kill "$SLURP_PID" "$MONITOR_PID" 2>/dev/null
wait "$SLURP_PID" "$MONITOR_PID" 2>/dev/null

# If an item was successfully selected, decode and copy to clipboard
if [ $rofi_status -eq 0 ] && [[ "$selected_idx" =~ ^[0-9]+$ ]] && [ "$selected_idx" -lt "${#raw_items[@]}" ]; then
    printf '%s\n' "${raw_items[$selected_idx]}" | cliphist decode | wl-copy
fi
