        lbl_caff_icon.set_valign(Gtk.Align.CENTER)
        caff_card.pack_start(lbl_caff_icon, False, False, 0)

        vbox_caff = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_caff_title = Gtk.Label()
        lbl_caff_title.set_markup("<b>Caffeine Mode</b>")
        lbl_caff_title.set_halign(Gtk.Align.START)
        vbox_caff.pack_start(lbl_caff_title, False, False, 0)

        self.lbl_caff_desc = Gtk.Label()
        self.lbl_caff_desc.set_halign(Gtk.Align.START)
        vbox_caff.pack_start(self.lbl_caff_desc, False, False, 0)
        caff_card.pack_start(vbox_caff, True, True, 0)

        self.btn_caff_toggle = Gtk.Button(label="Off")
        self.btn_caff_toggle.get_style_context().add_class("btn-caffeine")
        self.btn_caff_toggle.set_valign(Gtk.Align.CENTER)
        self.btn_caff_toggle.connect("clicked", lambda b: self.toggle_caffeine())
        caff_card.pack_end(self.btn_caff_toggle, False, False, 0)

        content_box.pack_start(caff_card, False, False, 0)

        # 1. Section: Display Refresh Rate
        lbl_hz_title = Gtk.Label(label="DISPLAY REFRESH RATE (HZ)")
        lbl_hz_title.get_style_context().add_class("section-title")
