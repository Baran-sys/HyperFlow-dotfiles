        lbl_hz_title.set_halign(Gtk.Align.START)
        content_box.pack_start(lbl_hz_title, False, False, 0)

        self.listbox_hz = Gtk.ListBox()
        self.listbox_hz.set_selection_mode(Gtk.SelectionMode.NONE)
        content_box.pack_start(self.listbox_hz, False, False, 0)

        # 2. Section: Power Profiles
        lbl_prof_title = Gtk.Label(label="POWER PROFILE")
        lbl_prof_title.get_style_context().add_class("section-title")
        lbl_prof_title.set_markup("<small><span alpha='65%'><b>POWER PROFILE (CPU / ENERGY)</b></span></small>")
        lbl_prof_title.set_halign(Gtk.Align.START)
        content_box.pack_start(lbl_prof_title, False, False, 0)

        self.listbox_prof = Gtk.ListBox()
        self.listbox_prof.set_selection_mode(Gtk.SelectionMode.NONE)
        content_box.pack_start(self.listbox_prof, False, False, 0)

        # Status Bar
        status_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        status_bar.get_style_context().add_class("status-bar")
