        status_bar.pack_start(self.lbl_footer, True, True, 0)
        main_box.pack_end(status_bar, False, False, 0)

        self.show_all()
        self.set_focus(None)

        def _init_power():
            self.refresh_ui()
            return False

        GLib.idle_add(_init_power)
        GLib.timeout_add_seconds(5, self.on_timer_refresh)

    def on_focus_out(self, widget, event):
        if getattr(self, "ready_to_close", False) and not getattr(self, "is_showing_dialog", False):
            self.close()
            return True
        return False

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def on_timer_refresh(self):
        if self.get_visible():
            self.refresh_ui()
        return True

    def get_battery_dir(self):
        for p in sorted(glob.glob("/sys/class/power_supply/BAT*")):
            if os.path.isdir(p):
                return p
        for p in sorted(glob.glob("/sys/class/power_supply/*")):
            t_file = os.path.join(p, "type")
            if os.path.isfile(t_file):
                try:
                    if open(t_file).read().strip() == "Battery":
                        return p
                except Exception:
                    pass
        return None

    def get_monitor_info(self):
        mon_name = "eDP-1"
        width = 1920
        height = 1080
        scale = 1.0
        current_hz = 60
        available_hz = []
        try:
            res = subprocess.check_output(["hyprctl", "monitors", "-j"], timeout=0.5).decode()
            data = json.loads(res)
            if data and len(data) > 0:
                m = next((x for x in data if x.get("focused")), data[0])
                mon_name = m.get("name", "eDP-1")
                width = int(m.get("width", 1920))
                height = int(m.get("height", 1080))
                scale = float(m.get("scale", 1.0))
                current_hz = int(round(float(m.get("refreshRate", 60))))
                res_prefix = f"{width}x{height}@"
                hz_set = set()
                for mode in m.get("availableModes", []):
                    if mode.startswith(res_prefix) and "Hz" in mode:
                        try:
                            hz_str = mode.split("@", 1)[1].replace("Hz", "").strip()
                            hz_val = int(round(float(hz_str)))
                            if hz_val >= 50:
                                hz_set.add(hz_val)
                        except Exception:
                            pass
                available_hz = sorted(hz_set, reverse=True)
        except Exception:
            pass
        if not available_hz:
            available_hz = sorted({current_hz, 60}, reverse=True)
        return mon_name, width, height, scale, current_hz, available_hz

    def get_dynamic_refresh_rates(self, available_hz, current_hz):
        if len(available_hz) >= 2:
            max_hz = max(available_hz)
            low_hz = 60 if 60 in available_hz and max_hz != 60 else min(available_hz)
            if max_hz != low_hz:
                return [
                    {
                        "hz": max_hz,
                        "name": f"{max_hz} Hz (Smooth Mode)",
                        "desc": "Maximum motion clarity and responsiveness",
                        "icon": "video-display-symbolic"
                    },
                    {
                        "hz": low_hz,
                        "name": f"{low_hz} Hz (Power Saving)",
                        "desc": "Lower display power consumption, longer battery",
                        "icon": "battery-symbolic"
                    }
                ]
        hz_only = available_hz[0] if available_hz else current_hz
        return [
            {
                "hz": hz_only,
                "name": f"{hz_only} Hz (Standard Mode)",
                "desc": "Default display refresh rate",
                "icon": "video-display-symbolic"
            }
        ]

    def get_current_profile(self):
        try:
            return subprocess.check_output(["powerprofilesctl", "get"]).decode().strip()
        except Exception:
            return "balanced"

    def get_battery_time_info(self, status, bat_dir):
        time_badge = ""
        badge_style = "badge-time"
        time_detail = ""
        if not bat_dir:
            return "Desktop • AC", "badge-full", "Connected to power source"
        try:
            if status == "Full":
                time_badge = "Plugged In • Full"
                badge_style = "badge-full"
                time_detail = "Battery fully charged, AC adapter connected"
            else:
                def _read_int(names):
                    for n in names:
                        p = os.path.join(bat_dir, n)
                        if os.path.exists(p):
                            return int(open(p).read().strip())
                    return 0

                c_now = _read_int(["charge_now", "energy_now"])
                curr = _read_int(["current_now", "power_now"])
                c_full = _read_int(["charge_full", "energy_full"])
                if curr > 0:
                    if status == "Discharging":
                        mins = int((c_now / curr) * 60)
                        h, m = divmod(mins, 60)
                        time_badge = f"{h}h {m}m left" if h else f"{m}m left"
                        badge_style = "badge-discharging"
                        time_detail = f"Estimated battery life: ~{h}h {m}m"
                    elif status == "Charging":
                        mins = int(((c_full - c_now) / curr) * 60)
                        h, m = divmod(mins, 60)
                        time_badge = f"{h}h {m}m to full" if h else f"{m}m to full"
                        badge_style = "badge-time"
                        time_detail = f"Estimated time until full: ~{h}h {m}m"
                elif status == "Charging":
                    time_badge = "Charging"
                    badge_style = "badge-time"
                    time_detail = "Device is charging"
                else:
                    time_badge = "Plugged In"
                    badge_style = "badge-full"
                    time_detail = "Running on AC power"
        except Exception:
            time_badge = "On Battery"
            badge_style = "badge-discharging"
            time_detail = "Running on battery power"
        return time_badge, badge_style, time_detail

    def get_battery_icon(self, cap_int, status):
        if status == "Charging":
            return "󰂄"
        if status == "Full" or cap_int >= 95:
            return "󰁹"
        if cap_int >= 80:
            return "󰂂"
        if cap_int >= 65:
            return "󰂀"
        if cap_int >= 50:
            return "󰁾"
        if cap_int >= 35:
            return "󰁽"
        if cap_int >= 20:
            return "󰁻"
        return "󰂃"

    def refresh_ui(self):
        current_prof = self.get_current_profile()
        mon_name, width, height, scale, current_hz, available_hz = self.get_monitor_info()
        dynamic_rates = self.get_dynamic_refresh_rates(available_hz, current_hz)

        self.header.set_subtitle(f"{current_prof.capitalize()}  •  {current_hz} Hz")
        self.lbl_footer.set_text(f"Profile: {current_prof.capitalize()}  •  Display: {current_hz} Hz ({mon_name})")

        # Battery status & time calculation
        bat_dir = self.get_battery_dir()
        try:
            if bat_dir:
                cap_file = os.path.join(bat_dir, "capacity")
                status_file = os.path.join(bat_dir, "status")
                cap = open(cap_file).read().strip() if os.path.exists(cap_file) else "100"
                status = open(status_file).read().strip() if os.path.exists(status_file) else "Full"
                cap_int = int(cap) if cap.isdigit() else 100
                icon = self.get_battery_icon(cap_int, status)
                self.lbl_pct.set_text(f"{icon}  %{cap}")

                time_badge, badge_style, time_detail = self.get_battery_time_info(status, bat_dir)

                if status == "Charging":
                    status_tr = f"Status: Charging ({time_detail})" if time_detail else "Status: Charging"
                elif status == "Full":
                    status_tr = "Status: Fully Charged (Plugged In)"
                else:
                    status_tr = f"Status: On Battery ({time_detail})" if time_detail else "Status: On Battery"
                self.lbl_status.set_text(status_tr)

                # Battery Health Calculation
                def _read_int(names):
                    for n in names:
                        p = os.path.join(bat_dir, n)
                        if os.path.exists(p):
                            try:
                                return int(open(p).read().strip())
                            except Exception:
                                pass
                    return 0

                b_full = _read_int(["energy_full", "charge_full"])
                b_design = _read_int(["energy_full_design", "charge_full_design"])
                b_cycles = _read_int(["cycle_count"])

                if b_design > 0 and b_full > 0:
                    health_pct = min(100, max(0, int(round((b_full / b_design) * 100))))
                    health_txt = f"Battery Health: {health_pct}%"
                    if b_cycles > 0:
                        health_txt += f"  •  Cycles: {b_cycles}"
                    self.lbl_health.set_markup(f"<small><span alpha='75%'>{health_txt}</span></small>")
                    self.lbl_health.show()
                else:
                    self.lbl_health.hide()

                self.lbl_time_badge.get_style_context().remove_class("badge-time")
                self.lbl_time_badge.get_style_context().remove_class("badge-discharging")
                self.lbl_time_badge.get_style_context().remove_class("badge-full")
                self.lbl_time_badge.get_style_context().add_class(badge_style)
                self.lbl_time_badge.set_text(time_badge)
                self.lbl_time_badge.show()
            else:
                self.lbl_pct.set_text("󰚥  AC Power")
                self.lbl_status.set_text("Status: Desktop / AC Power Supply")
                self.lbl_health.hide()
                self.lbl_time_badge.get_style_context().remove_class("badge-time")
                self.lbl_time_badge.get_style_context().remove_class("badge-discharging")
                self.lbl_time_badge.get_style_context().add_class("badge-full")
                self.lbl_time_badge.set_text("Plugged In")
                self.lbl_time_badge.show()
        except Exception:
            self.lbl_pct.set_text("󰁹  %100")
            self.lbl_status.set_text("Status: Plugged In")
            self.lbl_time_badge.hide()

        # Repopulate Refresh Rates
        for child in self.listbox_hz.get_children():
            self.listbox_hz.remove(child)

        for r in dynamic_rates:
            is_active = (abs(r["hz"] - current_hz) <= 1)
            row = Gtk.ListBoxRow()
            if is_active:
                row.get_style_context().add_class("hz-active")

            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            img = Gtk.Image.new_from_icon_name(r["icon"], Gtk.IconSize.DND)
            img.set_pixel_size(20)
            hbox.pack_start(img, False, False, 0)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            lbl_name = Gtk.Label()
            lbl_name.set_markup(f"<b>{r['name']}</b>")
            lbl_name.set_halign(Gtk.Align.START)
            vbox.pack_start(lbl_name, False, False, 0)

            lbl_desc = Gtk.Label()
            lbl_desc.set_markup(f"<small><span alpha='65%'>{r['desc']}</span></small>")
            lbl_desc.set_halign(Gtk.Align.START)
            vbox.pack_start(lbl_desc, False, False, 0)
            hbox.pack_start(vbox, True, True, 0)

            if is_active:
                badge = Gtk.Label(label="Active")
                badge.get_style_context().add_class("badge-hz-active")
                badge.set_valign(Gtk.Align.CENTER)
                hbox.pack_end(badge, False, False, 0)
            else:
                btn_set = Gtk.Button(label="Select")
                btn_set.get_style_context().add_class("btn-select")
                btn_set.set_valign(Gtk.Align.CENTER)
                btn_set.connect("clicked", lambda b, hz=r["hz"]: self.set_refresh_rate(hz))
                hbox.pack_end(btn_set, False, False, 0)

            row.add(hbox)
            def _on_hz_click(w, e, hz=r["hz"]):
                if e.button == 1:
                    self.set_refresh_rate(hz)
                    return True
                return False
            row.connect("button-press-event", _on_hz_click)
            self.listbox_hz.add(row)

        # Repopulate Power Profiles
        for child in self.listbox_prof.get_children():
            self.listbox_prof.remove(child)

        for p in PROFILES:
            is_active = (p["id"] == current_prof)
            row = Gtk.ListBoxRow()
            if is_active:
                row.get_style_context().add_class("profile-active")

            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            img = Gtk.Image.new_from_icon_name(p["icon"], Gtk.IconSize.DND)
            img.set_pixel_size(20)
            hbox.pack_start(img, False, False, 0)

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            lbl_name = Gtk.Label()
            lbl_name.set_markup(f"<b>{p['name']}</b>")
            lbl_name.set_halign(Gtk.Align.START)
            vbox.pack_start(lbl_name, False, False, 0)

            lbl_desc = Gtk.Label()
            lbl_desc.set_markup(f"<small><span alpha='65%'>{p['desc']}</span></small>")
            lbl_desc.set_halign(Gtk.Align.START)
            vbox.pack_start(lbl_desc, False, False, 0)
            hbox.pack_start(vbox, True, True, 0)

            if is_active:
                badge = Gtk.Label(label="Active")
                badge.get_style_context().add_class("badge-active")
                badge.set_valign(Gtk.Align.CENTER)
                hbox.pack_end(badge, False, False, 0)
            else:
                btn_set = Gtk.Button(label="Select")
                btn_set.get_style_context().add_class("btn-select")
                btn_set.set_valign(Gtk.Align.CENTER)
                btn_set.connect("clicked", lambda b, pid=p["id"]: self.set_profile(pid))
                hbox.pack_end(btn_set, False, False, 0)

            row.add(hbox)
            def _on_prof_click(w, e, pid=p["id"]):
                if e.button == 1:
                    self.set_profile(pid)
                    return True
                return False
            row.connect("button-press-event", _on_prof_click)
            self.listbox_prof.add(row)

        self.listbox_hz.show_all()
        self.listbox_prof.show_all()
        self.refresh_caffeine_ui()

    def is_caffeine_active(self):
        res = subprocess.run(["pgrep", "-x", "hypridle"], capture_output=True)
        return res.returncode != 0

    def toggle_caffeine(self):
        subprocess.run([os.path.expanduser("~/.local/bin/toggle-caffeine")])
        self.refresh_caffeine_ui()

    def refresh_caffeine_ui(self):
        active = self.is_caffeine_active()
        ctx = self.btn_caff_toggle.get_style_context()
        if active:
            self.btn_caff_toggle.set_label("Active")
            if not ctx.has_class("btn-caffeine-active"):
                ctx.add_class("btn-caffeine-active")
            self.lbl_caff_desc.set_markup("<small><span alpha='65%'>Screen sleep & lock are suspended</span></small>")
        else:
            self.btn_caff_toggle.set_label("Off")
            if ctx.has_class("btn-caffeine-active"):
                ctx.remove_class("btn-caffeine-active")
            self.lbl_caff_desc.set_markup("<small><span alpha='65%'>Automatic screen sleep & power saving</span></small>")

    def set_profile(self, profile_id):
        def _apply_prof():
            try:
                subprocess.run(["powerprofilesctl", "set", profile_id], check=True)
            except Exception as e:
                print(f"Error setting power profile: {e}")
            GLib.idle_add(self.refresh_ui)

        threading.Thread(target=_apply_prof, daemon=True).start()

    def set_refresh_rate(self, hz):
        def _apply_hz():
            try:
                mon_name, width, height, scale, _cur_hz, _avail = self.get_monitor_info()
                scale_str = f"{scale:g}"
                mon_spec = f"{mon_name},{width}x{height}@{hz},auto,{scale_str}"
                subprocess.run(["hyprctl", "keyword", "monitor", mon_spec], check=True)

                for conf_path in (
                    os.path.expanduser("~/.config/hypr/monitors.conf"),
                    os.path.expanduser("~/.config/hypr/hyprland.conf"),
                ):
                    if os.path.exists(conf_path):
                        with open(conf_path, "r") as f:
                            lines = f.readlines()
                        new_lines = []
                        replaced = False
                        for line in lines:
                            if line.strip().startswith(f"monitor={mon_name},") or line.strip().startswith(f"monitor = {mon_name},"):
                                new_lines.append(f"monitor={mon_spec}\n")
                                replaced = True
                            else:
                                new_lines.append(line)
                        if replaced:
                            with open(conf_path, "w") as f:
                                f.writelines(new_lines)
                            break
            except Exception as e:
                print(f"Error setting refresh rate: {e}")
            GLib.idle_add(self.refresh_ui)

        threading.Thread(target=_apply_hz, daemon=True).start()

class PowerMenuApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="org.antigravity.powermenu",
            flags=Gio.ApplicationFlags.NON_UNIQUE
        )
        self.window = None

    def do_activate(self):
        if not self.window:
            css_provider = Gtk.CssProvider()
            css_provider.load_from_data(SmartFocus.get_themed_css(CSS_STYLE))
            screen = Gdk.Screen.get_default()
            Gtk.StyleContext.add_provider_for_screen(
                screen,
                css_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

            self.window = PowerMenuWindow(self)
            self.window.connect('destroy', lambda w: setattr(self, 'window', None))
            self.window.present()
        else:
            self.window.close()
            self.window = None


if __name__ == "__main__":
    app = PowerMenuApp()
    sys.exit(app.run(sys.argv))
