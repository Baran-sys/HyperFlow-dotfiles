class PowerMenuWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(title="Power & Display Profiles", application=app)
        self.set_default_size(340, 460)

        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", self.on_focus_out)
        self.ready_to_close = False
        GLib.timeout_add(250, lambda: setattr(self, "ready_to_close", True) or False)
        try:
            from waybar_focus import SmartFocus
            SmartFocus.setup(self, align="right", offset=286)
        except Exception:
            pass

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_box)

        # HeaderBar
        self.header = Gtk.HeaderBar()
        self.header.set_show_close_button(True)
        self.header.set_title("Power & Display Profiles")
        self.set_titlebar(self.header)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        main_box.pack_start(scrolled, True, True, 0)

        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        scrolled.add(content_box)

        # Battery Info Card
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        card.get_style_context().add_class("battery-card")

        h_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.lbl_pct = Gtk.Label(label="Loading battery...")
        self.lbl_pct.get_style_context().add_class("battery-pct")
        h_box.pack_start(self.lbl_pct, False, False, 0)

        self.lbl_time_badge = Gtk.Label(label="")
        self.lbl_time_badge.set_valign(Gtk.Align.CENTER)
        h_box.pack_end(self.lbl_time_badge, False, False, 0)

        card.pack_start(h_box, False, False, 0)

        self.lbl_status = Gtk.Label(label="")
        self.lbl_status.get_style_context().add_class("battery-state")
        self.lbl_status.set_halign(Gtk.Align.START)
        card.pack_start(self.lbl_status, False, False, 0)

        self.lbl_health = Gtk.Label(label="")
        self.lbl_health.get_style_context().add_class("battery-health")
        self.lbl_health.set_halign(Gtk.Align.START)
        card.pack_start(self.lbl_health, False, False, 0)

        content_box.pack_start(card, False, False, 0)

