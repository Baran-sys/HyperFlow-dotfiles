#!/usr/bin/env python3
import sys
import os
import signal

# Fast single-instance toggle: Close existing instance in <5ms without loading GTK
my_pid = os.getpid()
my_name = os.path.basename(sys.argv[0])
for pid_str in os.listdir('/proc'):
    if pid_str.isdigit() and int(pid_str) != my_pid:
        try:
            with open(f'/proc/{pid_str}/cmdline', 'rb') as pf:
                cmd = pf.read().decode(errors='ignore')
                if my_name in cmd and 'python' in cmd:
                    os.kill(int(pid_str), signal.SIGTERM)
                    sys.exit(0)
        except Exception:
            pass

import sys
import os
